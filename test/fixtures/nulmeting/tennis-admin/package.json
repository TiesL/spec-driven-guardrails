{
  "name": "tennis-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Geïntegreerde webapplicatie voor Ties' tennislesadministratie",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "build": "node scripts/build.mjs",
    "push": "npm run build && clasp push --force",
    "deploy": "node scripts/deploy.mjs",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@google/clasp": "^3.0.0",
    "@types/google-apps-script": "^1.0.83",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.0"
  }
}
