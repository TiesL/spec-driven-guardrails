#!/usr/bin/env bash
# check — Everything that decides whether a change in this repo is good.
#
# This is the `check` command that WORKFLOW.md prescribes, applied here to
# this repo itself. CI only ever calls this script and doesn't invent
# separate steps — one source of truth, no drift between local and CI.
#
# Usage:
#   ./check                    # static checks + test suite
#   ./check --no-tests [dir]   # only the static checks, optionally on a
#                              # different directory (used by the test suite
#                              # itself, which would otherwise call itself)
#
# This repo deliberately has no package.json — that's not what governs the
# CI-adoption predicates anymore (#248: has-check-command, an executable
# `check` at the project root, which this file itself already satisfies).
# No package.json purely because this repo has no npm-based code to build.
#
# Bash 3.2-compatible: no declare -A, no mapfile, no ${var,,}.

set -uo pipefail

run_tests=1
if [ "${1:-}" = "--no-tests" ]; then
  run_tests=0
  shift
fi

own_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
target="${1:-$own_dir}"
target="$(cd "$target" 2>/dev/null && pwd)" || {
  echo "check: directory does not exist: ${1:-}" >&2
  exit 1
}

errors=0

report_error() {
  echo "  ERROR: $*" >&2
  errors=$((errors + 1))
}

# --- 1. Bash syntax ---------------------------------------------------------
# All *.sh plus the check script itself. .git is left out of consideration.
echo "check: bash -n"
# All shell scripts, NUL-separated so a path with spaces doesn't silently
# get split. Besides *.sh and `check`, extensionless files carrying a
# bash/sh shebang also count: the hook guards are named
# `hooks/git-guardrails` and are exactly the code where a silent syntax
# error is most costly.
script_list="$(mktemp)" || {
  echo "check: couldn't create a temp file — check aborted" >&2
  exit 1
}
trap 'rm -f "$script_list"' EXIT
{
  find "$target" -type f \( -name '*.sh' -o -name 'check' \) -not -path '*/.git/*' -print0
  find "$target" -type f -not -name '*.sh' -not -name 'check' -not -path '*/.git/*' -print0 \
    | while IFS= read -r -d '' candidate; do
        if [ ! -r "$candidate" ]; then
          # Not silently skipping: a file we can't read is a file we don't
          # know is a script or not.
          echo "  warning: ${candidate} couldn't be read — not checked" >&2
          continue
        fi
        case "$(head -c 2 "$candidate" 2>/dev/null)" in
          '#!')
            case "$(head -n 1 "$candidate" 2>/dev/null)" in
              # Only shells `bash -n` can meaningfully parse. Patterns
              # deliberately non-overlapping: "/sh" covers #!/bin/sh (also
              # with arguments), "env sh" covers #!/usr/bin/env sh.
              *bash*|*'/sh'*|*'env sh'*) printf '%s\0' "$candidate" ;;
            esac ;;
        esac
      done
} | sort -z -u > "$script_list"

while IFS= read -r -d '' script; do
  if ! error_message="$(bash -n "$script" 2>&1)"; then
    report_error "syntax error in ${script#"$target"/}: $error_message"
  fi
done < "$script_list"

# --- 2. JSON validation ------------------------------------------------------
# session-hooks.json is symlinked as .claude/settings.json in every adopted
# project. One typo there breaks it immediately, and `bash -n` doesn't see
# that. This step is deliberately separate from shellcheck: it's not
# optional.
echo "check: JSON validation"
json_file="$target/settings/session-hooks.json"
if [ -f "$json_file" ]; then
  if command -v jq >/dev/null 2>&1; then
    if ! error_message="$(jq empty "$json_file" 2>&1)"; then
      report_error "invalid JSON in settings/session-hooks.json: $error_message"
    fi
  elif command -v python3 >/dev/null 2>&1; then
    if ! error_message="$(python3 -m json.tool "$json_file" 2>&1 >/dev/null)"; then
      report_error "invalid JSON in settings/session-hooks.json: $error_message"
    fi
  else
    # Deliberately a hard error, not a warning. This is a purely local check
    # on a file that's symlinked into four projects; reporting "fine"
    # without having verified it is the silent degradation this repo pays
    # for most dearly. Install jq or python3.
    report_error "no jq and no python3 — settings/session-hooks.json couldn't be validated"
  fi
else
  report_error "settings/session-hooks.json is missing"
fi

# --- 3. NFR register versus the generated template block --------------------
# templates/PRD.md is a build artifact for that block. Without this check,
# the register and template could silently drift apart — exactly the drift
# the register was meant to remove.
if [ -d "$target/nfr" ] && [ -f "$target/templates/PRD.md" ]; then
  echo "check: NFR register"
  if [ -r "$target/lib/nfr.sh" ]; then
    # shellcheck source=lib/nfr.sh
    . "$target/lib/nfr.sh"

    # First the register itself. A broken file would otherwise disappear
    # from *all* consumers at once, and then the drift check sees nothing:
    # both sides miss it after all.
    if ! problems="$(nfr_validate "$target/nfr")"; then
      report_error "the NFR register is incomplete:"
      printf '%s\n' "$problems" | sed 's/^/    /' >&2
    fi

    if differences="$(nfr_drift "$target/nfr" "$target/templates/PRD.md")"; then
      :
    else
      report_error "templates/PRD.md is out of sync with nfr/ — run ./generate-prd-block"
      printf '%s\n' "$differences" | sed 's/^/    regarding: /' >&2
    fi
  else
    report_error "lib/nfr.sh is missing or unreadable — NFR register not checked"
  fi
fi

# --- 3a. PR linkbacks in CHANGES.md / CHANGES-ARCHIEF.md (W21, F15) ---------
# Without this linkback, an adopted project can't find out *why* a row is
# in its own WORKFLOW-ADOPTIE.md (S32). CHANGES-ARCHIEF.md shares the same
# entry shape and counts too: retirement must not drop the linkback.
if [ -f "$target/CHANGES.md" ] && [ -r "$target/lib/changes.sh" ]; then
  echo "check: PR linkbacks"
  # shellcheck source=lib/changes.sh
  . "$target/lib/changes.sh"
  for source in "$target/CHANGES.md" "$target/CHANGES-ARCHIEF.md"; do
    [ -f "$source" ] || continue
    missing="$(pr_links_missing "$source")"
    if [ -n "$missing" ]; then
      report_error "${source#"$target"/} is missing a **PR:** field at:"
      printf '%s\n' "$missing" | sed 's/^/    - /' >&2
    fi
  done
fi

# --- 3b. Python syntax -------------------------------------------------------
# Parity with `bash -n`: since the guard has its input read by a Python
# script, that side deserves a syntax check too.
pyscripts="$(find "$target" -type f -name '*.py' -not -path '*/.git/*' | sort)"
if [ -n "$pyscripts" ]; then
  if command -v python3 >/dev/null 2>&1; then
    echo "check: python syntax"
    for script in $pyscripts; do
      if ! error_message="$(python3 -m py_compile "$script" 2>&1)"; then
        report_error "syntax error in ${script#"$target"/}: $error_message"
      fi
    done
    find "$target" -name '__pycache__' -type d -prune -exec rm -rf {} + 2>/dev/null
  else
    echo "check: python3 not installed — python syntax skipped"
  fi
fi

# --- 3c. No Dutch outside layer C (W43, #115) --------------------------------
# Repo-specific, not something an adopted project carries — gated on the
# script's own presence in $target so a sandboxed copy of this repo (used by
# the test suite itself) is checked the same way, without assuming
# anything about an arbitrary external project.
if [ -x "$target/check-no-dutch.sh" ]; then
  echo "check: no Dutch outside layer C"
  dutch_output="$(mktemp)"
  if ! "$target/check-no-dutch.sh" "$target" >"$dutch_output" 2>&1; then
    report_error "Dutch text found outside layer C — see below:"
    sed 's/^/    /' "$dutch_output" >&2
  fi
  rm -f "$dutch_output"
fi

# --- 3c2. No printf/echo piped into grep -q (SIGPIPE/pipefail race, #218) --
# Gated on the script's own presence, same reasoning as 3c: a sandboxed
# copy of this repo (used by the test suite itself) is checked the same
# way as the real one. The python3-missing case is checked here, visibly,
# rather than left to the sub-script's own exit-0 skip path: `check` only
# ever prints a sub-script's captured output when it *fails* (see the
# error branch below), so a silent, successful skip would otherwise
# vanish with zero signal — found during PR #226's pre-merge-review.
if [ -x "$target/check-no-sigpipe-race.sh" ]; then
  if command -v python3 >/dev/null 2>&1; then
    echo "check: no SIGPIPE/pipefail race"
    if ! sigpipe_output="$("$target/check-no-sigpipe-race.sh" "$target" 2>&1)"; then
      report_error "check-no-sigpipe-race.sh reported a problem:"
      printf '%s\n' "$sigpipe_output" | sed 's/^/    /' >&2
    fi
  else
    echo "check: python3 not installed — SIGPIPE/pipefail race check skipped"
  fi
fi

# --- 3c3. No apostrophe closing a python3 -c '...' block early (#228) ------
# Same gating and python3-visibility handling as 3c2 above.
if [ -x "$target/check-no-quote-break.sh" ]; then
  if command -v python3 >/dev/null 2>&1; then
    echo "check: no quote-breaking apostrophe"
    if ! quote_output="$("$target/check-no-quote-break.sh" "$target" 2>&1)"; then
      report_error "check-no-quote-break.sh reported a problem:"
      printf '%s\n' "$quote_output" | sed 's/^/    /' >&2
    fi
  else
    echo "check: python3 not installed — quote-break check skipped"
  fi
fi

# --- 3c4. check-traceability.sh (root) in sync with templates/ (#230) ------
# The two must stay identical — they diverged silently twice already
# (#147 wired the root copy into `check` at all, only then making drift
# visible; #167 found the root copy had gone untranslated while the
# template had already been translated). Gated on both existing: a
# project without `templates/` (fully adopted, no longer carries the
# scaffold source) isn't affected.
if [ -f "$target/check-traceability.sh" ] && [ -f "$target/templates/check-traceability.sh" ]; then
  echo "check: check-traceability.sh in sync with templates/"
  if ! traceability_diff="$(diff -u "$target/templates/check-traceability.sh" "$target/check-traceability.sh" 2>&1)"; then
    report_error "check-traceability.sh has drifted from templates/check-traceability.sh:"
    printf '%s\n' "$traceability_diff" | sed 's/^/    /' >&2
  fi
fi

# --- 3d. Traceability chain link 1: PRD.md <-> TEST-SCENARIOS.md (#147) -----
# This repo requires every adopted project to run this exact check
# (traceability-link-1 in CHANGES.md, answered `yes` in this repo's own
# WORKFLOW-ADOPTION.md), but until now never ran it on its own PRD.md/
# TEST-SCENARIOS.md — found when S85's own malformed Covers: field
# (`F6, W42/#114`) sat undetected until check-traceability.sh was run by
# hand. Gated on the script's own presence, same reasoning as 3c: a
# sandboxed copy of this repo is checked the same way as the real one,
# without assuming anything about an arbitrary external project.
if [ -x "$target/check-traceability.sh" ]; then
  echo "check: traceability (link 1)"
  if ! traceability_output="$("$target/check-traceability.sh" "$target" 2>&1)"; then
    report_error "check-traceability.sh reported a problem:"
    printf '%s\n' "$traceability_output" | sed 's/^/    /' >&2
  fi
fi

# --- 3e. Yes-answered NFR without its PRD.md subsection yet (#134) ----------
# A warning, not an error: a row answered "yes" a moment ago deserves a
# short, visible grace period before its PRD.md subsection exists. Without
# this, the gap only stays visible if someone happens to add a Notes
# explanation by hand — observed missing that discipline during
# tennis-invoicing's adoption catch-up (PR TiesL/tennis-invoicing#18/#19).
if [ -r "$target/lib/nfr.sh" ] && [ -d "$target/nfr" ]; then
  # shellcheck source=lib/nfr.sh
  . "$target/lib/nfr.sh"
  missing_subsections="$(nfr_missing_subsection "$target/nfr" "$target")"
  if [ -n "$missing_subsections" ]; then
    echo "check: NFR subsections"
    printf '%s\n' "$missing_subsections" | sed 's/^/  warning: /' >&2
  fi
fi

# --- 4. shellcheck -----------------------------------------------------------
# Warning, not requiring: not every machine has it, and a missing linter
# must not turn a green build red.
if command -v shellcheck >/dev/null 2>&1; then
  echo "check: shellcheck"
  while IFS= read -r -d '' script; do
    if ! error_message="$(shellcheck -s bash -x "$script" 2>&1)"; then
      echo "  warning: shellcheck on ${script#"$target"/}:" >&2
      echo "$error_message" >&2
    fi
  done < "$script_list"
else
  echo "check: shellcheck not installed — skipped (no error)"
fi

if [ "$errors" -gt 0 ]; then
  echo >&2
  echo "check: $errors error(s) found." >&2
  exit 1
fi

# --- 5. Test suite -----------------------------------------------------------
if [ "$run_tests" -eq 1 ]; then
  echo "check: test suite"
  if [ -x "$target/test/run.sh" ]; then
    if ! "$target/test/run.sh"; then
      exit 1
    fi
  else
    echo "check: test/run.sh is missing or not executable" >&2
    exit 1
  fi
fi

echo "check: ok."
