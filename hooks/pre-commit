#!/usr/bin/env bash
# hooks/pre-commit — Native git hook (W26, F17): covers commits that happen
# outside Claude Code — the plain terminal, an IDE, a different agent
# harness. hooks/git-guardrails (PreToolUse) only ever sees what Claude
# itself executes; this hook covers literally every tool on this machine.
#
# Installed by adopt.sh as a symlink to this file at
# <project>/.git/hooks/pre-commit — so there's no copy that can drift out of
# sync.
#
# Contract (git pre-commit): no arguments, runs after the commit has been
# assembled but before it's final. Exit status != 0 refuses the commit.
#
# The same rule as the PreToolUse guard (MAIN_BRANCH, the message text)
# comes from rules.sh — that lives in one place. What *is* different here:
# no quote-aware tokenization needed, git has already assembled the commit
# by the time this hook runs, so there's no command string to read.
#
# Known limitation: if the bash interpreter itself is missing, this script
# can't even run its own fail-open logic — that's inherent to a shell-script
# hook and can't be solved from inside the script. If only rules.sh is
# missing (source file gone), this script does let it through, loudly.
#
# Bash 3.2-compatible: no declare -A, no mapfile, no ${var,,}.

set -uo pipefail

target="$(readlink "${BASH_SOURCE[0]}" 2>/dev/null)"
if [ -z "$target" ]; then
  echo "warning: the pre-commit hook is no longer a symlink to claude-workflow — commit check skipped." >&2
  exit 0
fi
own_dir="$(cd "$(dirname "$target")" 2>/dev/null && pwd)"
rules_file="$own_dir/rules.sh"
if [ -z "$own_dir" ] || [ ! -r "$rules_file" ]; then
  echo "warning: git hooks couldn't find rules.sh — commit check skipped." >&2
  exit 0
fi
# shellcheck source=rules.sh
. "$rules_file"
MAIN_BRANCH="${MAIN_BRANCH:-main}"

# Same escape hatch as git-guardrails: a guard without an escape hatch
# eventually gets bypassed by editing the script instead, and that's worse
# than a guard you turn off explicitly.
if [ -n "${CLAUDE_WORKFLOW_GUARDRAILS_OFF:-}" ]; then
  echo "warning: git-guardrails is disabled via CLAUDE_WORKFLOW_GUARDRAILS_OFF." >&2
  exit 0
fi

# Exception: a repo with no commits. The very first commit is, by
# definition, on main — same exception as in git-guardrails.
if git rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
  branch="$(git symbolic-ref --short HEAD 2>/dev/null)"
  if [ "$branch" = "$MAIN_BRANCH" ]; then
    echo "Blocked by the git hook: commit on $MAIN_BRANCH." >&2
    echo >&2
    echo "Reason: $REASON_COMMIT_ON_MAIN" >&2
    echo >&2
    echo "If this is really necessary, turn off the guard explicitly for this one command:" >&2
    echo "  CLAUDE_WORKFLOW_GUARDRAILS_OFF=1 <command>" >&2
    exit 1
  fi

  # Issue-first branching (F19, issue #212): covers branches/commits made
  # outside Claude Code, where git-guardrails' PreToolUse check never runs.
  # Syntax only, no gh/network call — this hook stays fast and offline, the
  # PreToolUse guard is the layer that also verifies the issue exists.
  # <<< here-string, not a piped printf | grep -q: SIGPIPE/pipefail race,
  # see issue #218.
  if [ -n "$branch" ] && ! grep -qE "${BRANCH_ISSUE_PATTERN:-^$}" <<<"$branch"; then
    case "$branch" in
      feature/*|fix/*)
        echo "Blocked by the git hook: commit on $branch without an issue number." >&2
        echo >&2
        echo "Reason: $REASON_BRANCH_NO_ISSUE" >&2
        echo >&2
        echo "If this is really necessary, turn off the guard explicitly for this one command:" >&2
        echo "  CLAUDE_WORKFLOW_GUARDRAILS_OFF=1 <command>" >&2
        exit 1 ;;
    esac
  fi
fi

# #263/#378 (A21-A23): the commit-time check is the project's own declared
# `check-commit` (an executable at the project root), never the full
# ./check: the test suite runs in CI, and red tests never block a commit.
# Fail-closed on a real failure within the budget; fail-open when the check
# can't run (no lib/git-env.sh) or exceeds COMMIT_CHECK_BUDGET seconds:
# "couldn't verify" is not "verified and red". The budget is enforced by a
# plain-bash watchdog (no GNU timeout on stock macOS): TERM to the check's
# process group, a short grace, then KILL. COMMIT_CHECK_BUDGET must be a
# positive integer; anything else is rejected, never read as a timeout.
#
# #377 (A19): git exports repo-local variables (GIT_DIR, GIT_INDEX_FILE,
# GIT_PREFIX, ...) to this hook. They are cleared for the check-commit child
# only, so it can't act on this repo instead of its own fixtures. Without
# lib/git-env.sh it is skipped rather than run uncleared.
project_dir="$(git rev-parse --show-toplevel 2>/dev/null)"
git_env_lib="$own_dir/../lib/git-env.sh"
COMMIT_CHECK_BUDGET="${COMMIT_CHECK_BUDGET-30}"
if [ -n "$project_dir" ] && [ -x "$project_dir/check-commit" ] && [ ! -r "$git_env_lib" ]; then
  echo "warning: git hooks couldn't find lib/git-env.sh — check-commit skipped (it can't run isolated from this repo's git environment)." >&2
elif [ -n "$project_dir" ] && [ -x "$project_dir/check-commit" ] \
  && ! grep -qE '^[1-9][0-9]*$' <<<"$COMMIT_CHECK_BUDGET"; then
  echo "Blocked by the git hook: COMMIT_CHECK_BUDGET must be a positive integer (seconds), got '${COMMIT_CHECK_BUDGET}'." >&2
  echo "Fix or unset COMMIT_CHECK_BUDGET (default 30); check-commit was not run." >&2
  exit 1
elif [ -n "$project_dir" ] && [ -x "$project_dir/check-commit" ]; then
  # shellcheck source=lib/git-env.sh
  . "$git_env_lib"
  cc_out="$(mktemp)" && cc_flag="$(mktemp)" || {
    echo "warning: couldn't create temp files — check-commit skipped." >&2
    exit 0
  }
  rm -f "$cc_flag"
  trap 'rm -f "$cc_out" "$cc_flag"' EXIT
  # set -m: each background job gets its own process group, so the watchdog
  # can kill check-commit together with everything it spawned.
  set -m
  ( git_local_env_clear; cd "$project_dir" && exec "$project_dir/check-commit" ) >"$cc_out" 2>&1 &
  cc_pid=$!
  # Watchdog: TERM, 2 s grace, KILL, all to the check's group.
  ( sleep "$COMMIT_CHECK_BUDGET"; : >"$cc_flag"; kill -TERM -- "-$cc_pid"
    sleep 2; kill -KILL -- "-$cc_pid" ) >/dev/null 2>&1 &
  cc_watchdog=$!
  wait "$cc_pid" 2>/dev/null
  cc_status=$?
  # The leader may have died on TERM while a grandchild that ignores TERM
  # lives on in the group (and the watchdog is about to be stopped below):
  # after a timeout, KILL whatever is left in the group.
  [ -e "$cc_flag" ] && kill -KILL -- "-$cc_pid" >/dev/null 2>&1
  kill -TERM -- "-$cc_watchdog" >/dev/null 2>&1
  wait "$cc_watchdog" 2>/dev/null
  set +m
  if [ -e "$cc_flag" ] && [ "$cc_status" -ne 0 ]; then
    echo "warning: check-commit exceeded the ${COMMIT_CHECK_BUDGET} s budget and was stopped; the commit is allowed, the full ./check runs in CI." >&2
  elif [ "$cc_status" -ne 0 ]; then
    echo "Blocked by the git hook: check-commit failed." >&2
    echo >&2
    cat "$cc_out" >&2
    echo >&2
    echo "If this is really necessary, turn off the guard explicitly for this one command:" >&2
    echo "  CLAUDE_WORKFLOW_GUARDRAILS_OFF=1 <command>" >&2
    exit 1
  fi
elif [ -n "$project_dir" ] && [ -x "$project_dir/check" ]; then
  echo "pre-commit: no check-commit declared; the full ./check runs in CI (see CHANGES.md ci-commit-check)." >&2
elif [ -n "$project_dir" ]; then
  echo "warning: no executable ./check at the project root — commit-time check skipped." >&2
fi

exit 0
