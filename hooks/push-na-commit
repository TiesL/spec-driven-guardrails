#!/usr/bin/env bash
# hooks/push-na-commit — PostToolUse hook (W25, F18): pushes the current
# branch as soon as a Bash call contains "git commit". The same action as
# the existing SessionEnd hook, only earlier and more often — work becomes
# safe as soon as it's committed, instead of only at a clean session end,
# for which Claude Code gives no guarantee (no promise around a crash, a
# closed terminal window, or a power outage).
#
# Contract (Claude Code PostToolUse): JSON on stdin with tool_name,
# tool_input.command, and cwd. The tool already ran — this hook can no
# longer stop anything, so exit status doesn't matter for the command
# itself.
#
# No attempt to derive "did the commit succeed" from tool_response: that
# structure isn't documented as a reliable source for the underlying
# command's exit status, and varies per tool. Instead, this script leans on
# something that *is* guaranteed true: `git push` is itself idempotent. If
# there's nothing new (the commit failed, or everything was already
# pushed), git reports "Everything up-to-date" and nothing changes —
# functionally the same result AC3 asks for, without relying on an
# undocumented field.
#
# Bash 3.2-compatible: no declare -A, no mapfile, no ${var,,}.

set -uo pipefail

invoer="$(</dev/stdin)"
[ -n "$invoer" ] || exit 0

if ! command -v python3 >/dev/null 2>&1; then
  exit 0
fi

# Two fields from the same JSON, one python3 call. No eval, no ad-hoc regex
# on raw JSON text — quotes and escape characters belong to a parser, not
# to grep.
gegevens="$(printf '%s' "$invoer" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if not isinstance(data, dict) or data.get("tool_name") != "Bash":
    sys.exit(0)
ti = data.get("tool_input")
cmd = ti.get("command") if isinstance(ti, dict) else None
if not isinstance(cmd, str):
    sys.exit(0)
cwd = data.get("cwd")
if not isinstance(cwd, str):
    cwd = ""
print(cmd.replace("\n", " "))
print(cwd)
')"
[ -n "$gegevens" ] || exit 0

commando="$(printf '%s\n' "$gegevens" | sed -n '1p')"
cwd="$(printf '%s\n' "$gegevens" | sed -n '2p')"
[ -n "$cwd" ] || cwd="$PWD"

# Just a rough keyword check: this isn't a guard against misuse like
# git-guardrails, so no quote-aware tokenization needed. A missed match
# costs at most a slightly later push; a false match costs a no-op git
# push — neither is harmful.
case "$commando" in
  *git\ commit*) ;;
  *) exit 0 ;;
esac

branch="$(git -C "$cwd" symbolic-ref --short HEAD 2>/dev/null)" || exit 0
[ -n "$branch" ] || exit 0

# AC4: nothing happens on main — the same boundary as the SessionEnd hook.
[ "$branch" = "main" ] && exit 0

if ! git -C "$cwd" remote get-url origin >/dev/null 2>&1; then
  exit 0
fi

# AC5: no network, no problem — report, don't hold things up.
if git -C "$cwd" rev-parse --verify --quiet "origin/$branch" >/dev/null 2>&1; then
  uitvoer="$(git -C "$cwd" push origin "$branch" 2>&1)" && exit 0
else
  uitvoer="$(git -C "$cwd" push -u origin "$branch" 2>&1)" && exit 0
fi

# Two very different causes, two different messages. A non-fast-forward
# (for example after `git commit --amend` or a rebase) is not a network or
# access problem — it's local history diverging from origin, and this hook
# never fixes that automatically with a force-push: that's a deliberate
# choice, not a mutation nobody asked for.
case "$uitvoer" in
  *"(non-fast-forward)"*|*"(fetch first)"*|*"(stale info)"*)
    echo "warning: push-na-commit couldn't push — local history diverges from origin (for example after an amend or rebase). Use 'git push --force-with-lease' yourself if that was the intent." >&2 ;;
  *)
    echo "warning: push-na-commit couldn't push (no network or no access?): $uitvoer" >&2 ;;
esac
exit 0
