#!/usr/bin/env bash
# hooks/git-guardrails — PreToolUse guard against destructive git commands,
# and (W10b, F8) the merge guard on `gh pr merge`.
#
# "Never directly to main" was an agreement with no lock: branch protection
# requires a paid plan on private repos. This is that lock.
#
# Second case, same mechanism: `gh pr merge` is blocked if the PR doesn't
# carry a machine-recognizable review marker (which `pre-merge-review`
# places, F11), or if the PR has checks that haven't passed (issue #81 — CI
# failed six runs in a row, unnoticed, because nothing in the merge flow
# looked at it). Fails open without `gh` or network — neither check is ever
# the command that locks up a session. A substantiated `no` on the
# `quality-review-before-merge` row in `WORKFLOW-ADOPTION.md` turns off
# both checks for that project, read locally, with no network call.
#
# Contract (Claude Code PreToolUse): JSON on stdin with `tool_name` and
# `tool_input.command`; exit status 2 blocks and stderr becomes the message
# to Claude. Any other status lets the command through.
#
# Ground rule: when in doubt, allow. A missed case is annoying; a false
# positive blocks work in four projects at once and reaches them without a
# re-adoption, because the hook configuration is symlinked.
#
# Bash 3.2-compatible: no declare -A, no mapfile, no ${var,,}.

set -uo pipefail

# Codex opts into merge interception only; the ordinary Claude Interface
# continues to judge all existing Git policies.
merge_only=0
case "${1:-}" in
  --merge-only) [ "$#" -eq 1 ] || exit 2; merge_only=1 ;;
  '') ;;
  *) echo "git-guardrails: unknown argument: $1" >&2; exit 2 ;;
esac

# Deliberate escape hatch. A guard without an escape hatch eventually gets
# bypassed by editing the script instead, and that's worse than a guard you
# turn off explicitly.
if [ -n "${CLAUDE_WORKFLOW_GUARDRAILS_OFF:-}" ]; then
  echo "warning: git-guardrails is disabled via CLAUDE_WORKFLOW_GUARDRAILS_OFF." >&2
  exit 0
fi

# Reading with a bash redirect instead of `cat`: the guard must still be
# able to give its warning even on a bare PATH, and that doesn't work if it
# already trips over a missing utility.
input="$(</dev/stdin)"
[ -n "$input" ] || exit 0

own_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
reader="$own_dir/read-command.py"

# MAIN_BRANCH and the REDEN_* texts come from rules.sh, shared with the
# native git hooks (W26) — which branch is protected and what the message
# says lives in one place this way. If the file is missing (broken
# checkout), this falls back to the hardcoded "main": when in doubt, allow
# also applies here to the guard's own infrastructure.
if [ -r "$own_dir/rules.sh" ]; then
  # shellcheck source=rules.sh
  . "$own_dir/rules.sh"
fi
MAIN_BRANCH="${MAIN_BRANCH:-main}"

if ! command -v python3 >/dev/null 2>&1; then
  echo "warning: git-guardrails needs python3 to read the command" >&2
  echo "and so lets this command through. Install python3 to make the guard work." >&2
  exit 0
fi
if [ ! -r "$reader" ]; then
  echo "warning: git-guardrails is missing $reader and lets this command through." >&2
  exit 0
fi

# The reader is the only thing that decides how the command is read: JSON,
# heredocs, quoting, and tokenization. This guard only ever compares tokens.
# Without that separation, bash had to emulate quoting, and that blocked
# innocent commands — a `;` in a commit message split the command into
# pieces.
#
# Via a file, not via $(...): a token stream is NUL-separated and command
# substitution discards NUL bytes.
stream="$(mktemp)" || exit 0
trap 'rm -f "$stream"' EXIT

printf '%s' "$input" | python3 "$reader" > "$stream"
case $? in
  0) ;;
  4) exit 0 ;;   # not a Bash call, or no command
  *) exit 0 ;;   # unreadable: don't guess at a reading
esac

# --- helper functions -------------------------------------------------------
# The path-determining options of the judged command come along, so git
# itself computes which repo is meant. `git -C ../other push origin HEAD`
# acts on that other repo, not on the directory the session happens to be
# in.
#
# Deliberately only `-C`, `--git-dir`, and `--work-tree`: those determine the
# path. Other global options come from the same untrusted text as the
# command itself and are not passed through. That means the guard misses
# `-c core.worktree=<path>` — the same effect via the config route.
# Deliberately accepted: opening up that case requires an allowlist of safe
# config keys, and a missed case weighs less here than reopening that
# question.
#
# As an argv array, never as a composed string: letting a shell read that
# again brings back exactly the word splitting this guard removes.
# `symbolic-ref` and not `rev-parse --abbrev-ref`: the latter returns the
# literal text "HEAD" instead of the branch name on a repo with no commits.
# That happens to work here — "HEAD" is simply never "main" — but it's a
# coincidence, and whoever ever "fixes" that call would silently block the
# first commit of every new project. symbolic-ref also names the branch
# before the first commit; the exception for that lives explicitly at
# `commit` and doesn't rely on a coincidence.
#
# A detached HEAD yields an empty name, and that falls, via `is_main`, in
# the safe direction: don't block.
current_branch() {
  if [ "${#path_options[@]}" -gt 0 ]; then
    git -C "$workdir" "${path_options[@]}" symbolic-ref --short HEAD 2>/dev/null
  else
    git -C "$workdir" symbolic-ref --short HEAD 2>/dev/null
  fi
}

block() {
  echo "Blocked by git-guardrails: $1" >&2
  echo "" >&2
  echo "Reason: $2" >&2
  echo "" >&2
  echo "If this is really necessary, turn off the guard explicitly for this one command:" >&2
  echo "  CLAUDE_WORKFLOW_GUARDRAILS_OFF=1 <command>" >&2
  exit 2
}

# Determines the destination of one refspec. `feature:main` yields `main`,
# `+main` yields `main`, `:main` (delete) too.
refspec_target() {
  local spec="${1#+}"
  case "$spec" in
    *:*) echo "${spec##*:}" ;;
    *)   echo "$spec" ;;
  esac
}

is_main() {
  case "$1" in
    "$MAIN_BRANCH"|"refs/heads/$MAIN_BRANCH") return 0 ;;
    *) return 1 ;;
  esac
}

# --- issue-first branch guard (F19, issue #212) -----------------------------
# A new feature/fix branch must name the issue it implements
# (feature/123-short-desc): requiring the number forces the issue to exist
# before the branch can even be named. $1 is the branch name being created
# (from `checkout -b`/`switch -c`); $2 is the subcommand, for the message.
check_branch_creation() {
  local branch="$1" sub_cmd="$2"
  [ -n "$branch" ] || return 0

  case "$branch" in
    feature/*|fix/*) ;;
    *) return 0 ;;
  esac

  # <<< here-string, not a piped printf | grep -q: SIGPIPE/pipefail race,
  # see issue #218.
  if ! grep -qE "${BRANCH_ISSUE_PATTERN:-^$}" <<<"$branch"; then
    block "git $sub_cmd $branch" "${REASON_BRANCH_NO_ISSUE:-every feature/fix branch names the issue it implements, e.g. feature/123-short-desc.}"
  fi

  # AC3: fail open without gh — same rule as the merge guard below.
  if ! command -v gh >/dev/null 2>&1; then
    echo "warning: issue-first branch guard can't find gh and skips the issue-existence check." >&2
    return 0
  fi

  local issue_number state status
  issue_number="${branch#*/}"
  issue_number="${issue_number%%-*}"

  state="$(gh issue view "$issue_number" --json state --jq .state 2>/dev/null)"
  status=$?
  if [ "$status" -ne 0 ] || [ -z "$state" ]; then
    echo "warning: issue-first branch guard couldn't consult issue #$issue_number (no network or no access) and skips the check." >&2
    return 0
  fi

  if [ "$state" != "OPEN" ]; then
    block "git $sub_cmd $branch" \
"issue #$issue_number is $state, not open — a branch must reference an open
       issue.

       Is this deliberate, use the explicit escape hatch:
         CLAUDE_WORKFLOW_GUARDRAILS_OFF=1 <command>"
  fi
}

# --- the merge guard (W10b, F8) ---------------------------------------------
# The marker pattern that `pre-merge-review` (F11) literally prescribes:
# <!-- pre-merge-review:done sha=<40-hex-char HEAD sha> -->. Pinned to a
# commit (issue #225) — a marker posted for an older commit must not be
# accepted for a newer one, so a fix commit pushed after review (whether
# the review ran before or after CI) always requires a fresh one. The
# regex itself lives inline in check_merge_guard's python block below, not
# duplicated here as a second source of truth.

# Prints the matched host/owner/repository, or `different`; failure means
# unknown. Read the raw origin offline: rewrites and SSH aliases aren't
# evidence of canonical identity, and must not trigger a network fallback.
merge_repository_identity() {
  python3 - "$workdir" "$1" "${GH_HOST:-github.com}" <<'PY'
import re, subprocess, sys

def config(*args):
    return subprocess.run(["git", "-C", sys.argv[1], "config", *args],
                          capture_output=True, text=True)

def normalize(value):
    parts = value.lower().split("/")
    if len(parts) != 3:
        raise ValueError()
    host, owner, repo = parts
    if repo.endswith(".git"):
        repo = repo[:-4]
    if not re.fullmatch(r"[a-z0-9]+(?:[.-][a-z0-9]+)*", host):
        raise ValueError()
    if not re.fullmatch(r"[a-z0-9_-]+", owner) or not re.fullmatch(r"[a-z0-9_.-]+", repo):
        raise ValueError()
    if repo in (".", ".."):
        raise ValueError()
    return "/".join((host, owner, repo))

try:
    origin = config("--get", "remote.origin.url")
    if origin.returncode != 0:
        raise ValueError()
    raw = origin.stdout.rstrip("\n")
    rewrites = config("--get-regexp", r"^url\..*\.insteadof$")
    if rewrites.returncode not in (0, 1):
        raise ValueError()
    for row in rewrites.stdout.splitlines():
        prefix = row.split(None, 1)[1]
        if raw.startswith(prefix):
            raise ValueError()
    match = (re.fullmatch(r"(?:https://|ssh://(?:[^/@:]+@)?)([^/:]+)/([^/]+/[^/]+)", raw)
             or re.fullmatch(r"(?:[^/@:]+@)?([^/:]+):([^/]+/[^/]+)", raw))
    if not match or "." not in match[1]:
        raise ValueError()
    local_repo = normalize(match[1] + "/" + match[2])
    explicit = sys.argv[2]
    if explicit.count("/") == 1:
        explicit = sys.argv[3] + "/" + explicit
    selected = normalize(explicit)
    print(selected if selected == local_repo else "different")
except (ValueError, IndexError, OSError):
    sys.exit(1)
PY
}

# Judges `gh ...` segments. Only `pr merge` is relevant; everything else
# passes through untouched.
#
# Value flags of "gh pr merge" that claim the *next* token (source: `gh pr
# merge --help`). Without this list, `--body "text"`, for example, would
# shift into the target position (number/url/branch), and the guard would
# judge the wrong PR instead of the current branch's PR — exactly the case
# where `gh pr view <body text>` fails and the guard, via the fail-open
# path, lets a PR without a marker through anyway.
judge_gh_segment() {
  local arg repo="" repo_count=0 identity

  local positions=()
  while [ $# -gt 0 ]; do
    arg="$1"
    case "$arg" in
      -R|--repo)
        repo_count=$((repo_count + 1))
        repo="${2:-}"
        shift
        if [ $# -gt 0 ] && [[ "$1" != -* ]]; then shift; fi
        continue ;;
      -R*|--repo=*)
        repo_count=$((repo_count + 1))
        case "$arg" in -R*) repo="${arg#-R}" ;; *) repo="${arg#--repo=}" ;; esac
        shift
        continue ;;
      -A|--author-email|-b|--body|-F|--body-file|--match-head-commit|-t|--subject)
        [ $# -ge 2 ] || return 0
        shift 2
        continue ;;
      --author-email=*|--body=*|--body-file=*|--match-head-commit=*|--subject=*)
        shift
        continue ;;
      -*)
        shift
        continue ;;
      *)
        positions+=("$arg")
        shift ;;
    esac
  done

  [ "${positions[0]:-}" = "pr" ] && [ "${positions[1]:-}" = "merge" ] || return 0

  if [ "$repo_count" -gt 0 ]; then
    if [ "$repo_count" -ne 1 ] || ! identity="$(merge_repository_identity "$repo")"; then
      echo "warning: merge-guard couldn't establish repository identity and skips the merge checks." >&2
      return 0
    fi
    [ "$identity" = "different" ] && return 0
    # Local exported values reach every gh call, including the delegated
    # role gate, and are restored before the next command segment.
    local GH_REPO="$identity" GH_HOST="${identity%%/*}"
    export GH_REPO GH_HOST
  fi

  check_merge_guard "${positions[2]:-}"
}

# AC2–AC6 (F8/S15–S18): the actual judgment on one `gh pr merge`.
# $1 is the optional target (number/url/branch) that stood after "merge".
check_merge_guard() {
  local target="$1"

  # AC6: the explicit escape hatch, set in judge_segment (already
  # loudly reported).
  [ "${merge_guard_off:-0}" -eq 1 ] && return 0

  # AC5: a substantiated `no` on quality-review-before-merge turns it off —
  # local grep, before any gh call, so no network. Checks both the new and
  # the pre-migration (W42/#114) filename/ID/value, since a project that
  # hasn't migrated yet still answers with the old vocabulary.
  local project_root answers line answer
  project_root="$(git -C "$workdir" rev-parse --show-toplevel 2>/dev/null)"
  [ -n "$project_root" ] || project_root="$workdir"
  answers="$project_root/WORKFLOW-ADOPTION.md"
  if [ -f "$answers" ]; then
    line="$(grep -m1 '^| *quality-review-before-merge *|' "$answers")"
    if [ -n "$line" ]; then
      answer="$(printf '%s\n' "$line" | awk -F'|' '{a=$3; gsub(/^[ \t]+|[ \t]+$/, "", a); print a}')"
      [ "$answer" = "no" ] && return 0
    fi
  fi
  answers="$project_root/WORKFLOW-ADOPTIE.md"
  if [ -f "$answers" ]; then
    line="$(grep -m1 '^| *kwaliteitsreview-voor-merge *|' "$answers")"
    if [ -n "$line" ]; then
      answer="$(printf '%s\n' "$line" | awk -F'|' '{a=$3; gsub(/^[ \t]+|[ \t]+$/, "", a); print a}')"
      [ "$answer" = "nee" ] && return 0
    fi
  fi

  # AC4: fail open without gh.
  if ! command -v gh >/dev/null 2>&1; then
    echo "warning: merge-guard can't find gh and skips the up-to-date and review checks." >&2
    return 0
  fi

  # #516 (A43): before the marker lookup, so a stale PR gets the one
  # actionable message (update-branch) before it is told to review a head
  # that is about to change.
  check_up_to_date_guard "$target"

  local call output status
  if [ -n "$target" ]; then
    call=(gh pr view "$target" --json comments,headRefOid)
  else
    call=(gh pr view --json comments,headRefOid)
  fi

  # stdout and stderr kept separate, not merged: this now parses real
  # JSON to compare a sha, not a substring case match — stream
  # contamination would otherwise silently fail this check open, the same
  # bug class check_ci_guard below was hardened against for issue #81 and
  # check_stray_closes_guard for PR #224's own review.
  local error_file error_text
  error_file="$(mktemp)" 2>/dev/null || error_file=""
  if [ -n "$error_file" ]; then
    output="$(cd "$workdir" && "${call[@]}" 2>"$error_file")"
    status=$?
    error_text="$(cat "$error_file" 2>/dev/null)"
    rm -f "$error_file"
  else
    output="$(cd "$workdir" && "${call[@]}" 2>/dev/null)"
    status=$?
    error_text=""
  fi

  # AC4: fail open without network (or any other reason gh can't consult
  # the PR — when in doubt, allow, the same ground rule as everywhere else
  # in this script).
  if [ "$status" -ne 0 ]; then
    echo "warning: merge-guard couldn't consult the PR (no network or no access) and skips the review check." >&2
    [ -n "$error_text" ] && echo "$error_text" >&2
    return 0
  fi

  # A marker counts only when it names the PR's *current* HEAD commit
  # (issue #225) — a marker posted for an older commit (a fix pushed
  # after review, whether the review ran before or after CI) must not be
  # accepted for a newer one.
  local marker_status parse_status
  marker_status="$(printf '%s' "$output" | python3 -c '
import json, re, subprocess, sys

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(1)

# A missing/empty headRefOid is an unparseable response, not "no commit
# matches" — falling through with head_sha="" would make every marker
# compare STALE and hard-block the merge, instead of failing open the
# same way every other uncertain-state branch here does. Found during
# this PRs own pre-merge-review (round 2).
head_sha = data.get("headRefOid") or ""
if not head_sha:
    sys.exit(1)
pattern = re.compile(r"<!-- pre-merge-review:done sha=([0-9a-fA-F]{40}) -->")
for comment in (data.get("comments") or []):
    # Fixed program, positional data: comment text never becomes shell code.
    # Bytes preserve GitHub UTF-8 independently of the invoking locale.
    try:
        args = ["bash", "-c", ". \"$1\" || exit; live_text \"$2\"", "markdown",
                sys.argv[1], comment.get("body") or ""]
        parsed = subprocess.run(
            [arg.encode("utf-8", "surrogateescape") for arg in args],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except (OSError, ValueError):
        sys.exit(1)
    if parsed.returncode != 0:
        sys.exit(1)
    live = parsed.stdout.decode("utf-8", "surrogateescape")
    for m in pattern.finditer(live):
        if m.group(1) == head_sha:
            print("OK")
            sys.exit(0)
print("STALE")
' "$own_dir/../lib/markdown.sh")"
  parse_status=$?

  if [ "$parse_status" -ne 0 ]; then
    echo "warning: merge-guard couldn't interpret the PR's comments (unexpected output from gh pr view) and skips the review check." >&2
    return 0
  fi

  if [ "$marker_status" != "OK" ]; then
    block "gh pr merge without a review marker for the current commit" \
"this PR doesn't carry a pre-merge-review marker for its current HEAD
       commit — either no review has run yet, or a commit landed after the
       last one did. Run that skill again and leave the findings (with a
       fresh marker) on the PR.

       Is this deliberate, use the explicit escape hatch — and report which
       check is being skipped:

         CLAUDE_WORKFLOW_MERGE_GUARD_OFF=1 <command>"
  fi

  check_ci_guard "$target"
  check_stray_closes_guard "$target"
  check_role_play_guard "$target"
}

# #516 (A43, F8 extended): refuse a PR whose base tip is not an ancestor of
# its head. Parallel work items can take the same S/F/A number and CI does
# not re-run when the base moves, so a stale green run could merge a
# duplicate; `main` has strict required checks, release branches and
# private adopted projects do not. One code path for every base: the PR's
# own base.ref is read, no branch-name filter.
#
# REST only (the #318/#355 defect class rules out GraphQL-backed
# `gh pr view`): the PR number via resolve_stray_closes_pr_number, then
# `pulls/<n>` for base.ref and head.sha, then `compare/<base>...<head>`,
# whose behind_by is the server-side ancestry test (0 = the base tip is an
# ancestor of the head). No local fetch: the checkout may not hold the PR
# branch. Fails open with a warning on any lookup trouble (no PR number,
# a failing call, an empty or non-numeric answer, a fork head unknown to
# the base repo), same ground rule as the checks beside it. The escape
# hatch and a substantiated `no` on quality-review-before-merge are
# inherited from check_merge_guard, which returns before calling this.
#
# $1 is the same optional target (number/url/branch) as the other checks.
check_up_to_date_guard() {
  local target="$1" skip="and skips the up-to-date check."

  local number
  if ! number="$(resolve_stray_closes_pr_number "$target")"; then
    echo "warning: merge-guard couldn't determine the PR number $skip" >&2
    return 0
  fi

  # stdout and stderr kept separate (#81/#224): a routine stderr line
  # from gh must not end up in the parsed answer.
  local error_file pull_part compare_part status error_text
  error_file="$(mktemp)" 2>/dev/null || error_file=/dev/null
  pull_part="$(cd "$workdir" && gh api "repos/{owner}/{repo}/pulls/$number" --jq '.base.ref + "\t" + .head.sha' 2>"$error_file")"
  status=$?
  error_text="$(cat "$error_file" 2>/dev/null)"
  if [ "$status" -ne 0 ]; then
    echo "warning: merge-guard couldn't consult the PR's base and head (no network or no access) $skip" >&2
    [ -n "$error_text" ] && echo "$error_text" >&2
    [ "$error_file" = /dev/null ] || rm -f "$error_file"
    return 0
  fi

  local base_ref head_sha
  IFS=$'\t' read -r base_ref head_sha <<<"$pull_part"
  if [ -z "$base_ref" ] || ! [[ "$head_sha" =~ ^[0-9a-fA-F]{40}$ ]]; then
    echo "warning: merge-guard couldn't interpret the PR's base and head (unexpected output from gh api) $skip" >&2
    [ "$error_file" = /dev/null ] || rm -f "$error_file"
    return 0
  fi

  compare_part="$(cd "$workdir" && gh api "repos/{owner}/{repo}/compare/$base_ref...$head_sha" --jq .behind_by 2>"$error_file")"
  status=$?
  error_text="$(cat "$error_file" 2>/dev/null)"
  [ "$error_file" = /dev/null ] || rm -f "$error_file"
  if [ "$status" -ne 0 ]; then
    echo "warning: merge-guard couldn't compare the PR's head with its base '$base_ref' (no network, no access, or a head the base repo doesn't know) $skip" >&2
    [ -n "$error_text" ] && echo "$error_text" >&2
    return 0
  fi

  local behind="$compare_part"
  if ! [[ "$behind" =~ ^[0-9]+$ ]]; then
    echo "warning: merge-guard couldn't interpret how far the PR is behind '$base_ref' (unexpected output from gh api: '$behind') $skip" >&2
    return 0
  fi
  [ "$behind" -eq 0 ] && return 0

  block "gh pr merge while the PR is behind its base" \
"this PR's head does not contain the tip of its base branch '$base_ref':
       it is $behind commit(s) behind. CI and the review ran on a head that
       never saw those commits, so a clash (for example a duplicate S/F/A
       number) would not show. Bring the base in with a merge, which needs no
       force-push:

         gh pr update-branch $number

       Then wait for CI on the new head and re-run the pre-merge review there
       (the marker is pinned to the head commit).

       Is this deliberate, use the explicit escape hatch — and report which
       check is being skipped:

         CLAUDE_WORKFLOW_MERGE_GUARD_OFF=1 <command>"
}

# #371 (A18 amendment): in a project that answers process-multi-agent-roles
# yes, a run where one session played every role, with no recorded human
# override, must not merge. The review-marker check above can't catch it:
# in exactly that failure the same session is also the Reviewer and can
# post the marker itself. One owner for the rule: the installed
# model-record-gate.sh computes it; this step only reads its
# `role-played: ` prefix. Opt-in only (the shared answered_yes rule), so a
# project that didn't answer yes sees no change. Fails open on everything
# uncertain — no lib or gate in this clone, an unresolvable PR, no gh or
# network (the gate itself exits 0 with no finding then) — same ground rule
# as the checks above. Part of the same gate: the same `no` on
# quality-review-before-merge and the same escape hatch turn it off.
# $1 is the same optional target (number/url/branch) as the other checks.
check_role_play_guard() {
  local target="$1"
  local lib="$own_dir/../lib/changes.sh"
  local gate="$own_dir/../skills/pre-merge-review/model-record-gate.sh"
  [ -r "$lib" ] && [ -x "$gate" ] || return 0

  local project_root
  project_root="$(git -C "$workdir" rev-parse --show-toplevel 2>/dev/null)"
  [ -n "$project_root" ] || project_root="$workdir"
  # shellcheck source=../lib/changes.sh
  . "$lib"
  answered_yes "$project_root" process-multi-agent-roles || return 0

  local number
  if ! number="$(resolve_stray_closes_pr_number "$target")"; then
    echo "warning: merge-guard couldn't determine the PR number and skips the role-play check." >&2
    return 0
  fi

  local output findings context warnings line
  output="$(cd "$workdir" && "$gate" "$number" 2>/dev/null)"
  warnings="$(LC_ALL=C grep '^role-play-unchecked: ' <<<"$output")"
  if [ -n "$warnings" ]; then
    printf 'warning: merge-guard role-play check was unchecked:\n%s\n' "$warnings" >&2
  fi
  findings="$(LC_ALL=C grep '^role-played: ' <<<"$output")"
  [ -n "$findings" ] || return 0
  context=""
  while IFS= read -r line; do
    case "$line" in 'model-record: '*) context="$context$line"$'\n';; esac
  done <<<"$output"

  block "gh pr merge on a role-played run" \
"this project answers process-multi-agent-roles yes, and
       model-record-gate.sh finds that one session played the pipeline's
       roles instead of dispatching them:

$(printf '%s\n' "$findings" "$context" | sed 's/^/       /')

       Re-post a whole record line using
       skills/pre-merge-review/model-record-emit.sh when a record is a
       near-miss. Dispatch each stage as its own role session, or, if the
       human decided otherwise, record that decision on the issue (live
       text, not quoted):

         <!-- pipeline-override: decided-by=\"human\" scope=\"single-session\" reason=\"...\" -->

       (or scope=\"skip=<Stage>\"; see the role-contracts skill's
       ORCHESTRATOR.md). Is this deliberate, use the explicit escape hatch —
       and report which check is being skipped:

         CLAUDE_WORKFLOW_MERGE_GUARD_OFF=1 <command>"
}

# Found while reviewing PR #80 (issue #81): CI had been systematically
# failing since PR #76, six runs in a row, and nothing in the merge flow
# saw it — no branch protection (private repo, no paid plan), and
# `gh pr merge` doesn't warn on failing checks. Same mechanism and
# fail-open philosophy as the review-marker check above, second check in
# the same gate.
#
# $1 is the same optional target (number/url/branch) as the marker check.
check_ci_guard() {
  local target="$1"

  local call output status
  if [ -n "$target" ]; then
    call=(gh pr checks "$target" --json "bucket,name")
  else
    call=(gh pr checks --json "bucket,name")
  fi

  # stdout and stderr kept separate, not merged with 2>&1: a routine stderr
  # line from gh (an update notice, a deprecation warning) would otherwise
  # contaminate the JSON on stdout. json.load would then fail, an earlier
  # broad except Exception caught that and so let a red PR through in
  # silence — no warning, just an empty findings list. Exactly the same
  # failure class as the bug this PR fixes, now prevented by separating the
  # streams instead of trusting clean output.
  #
  # gh's own --json normalizes the exit status of "checks failing/still
  # running" (normally 1 and 8 respectively, see `gh help exit-codes`) back
  # to 0: the call itself succeeded after all, only the content of the
  # checks isn't green. A non-zero status here therefore always means the
  # lookup itself failed (no network, no PR found, no access) — except the
  # case below, where gh returns its plain error message even with --json.
  local error_file error_text
  error_file="$(mktemp)" 2>/dev/null || error_file=""
  if [ -n "$error_file" ]; then
    output="$(cd "$workdir" && "${call[@]}" 2>"$error_file")"
    status=$?
    error_text="$(cat "$error_file" 2>/dev/null)"
    rm -f "$error_file"
  else
    output="$(cd "$workdir" && "${call[@]}" 2>/dev/null)"
    status=$?
    error_text=""
  fi

  # No checks reported is not an error and not a red flag: CI is optional
  # (see F6). gh doesn't return that case as an empty JSON list — even with
  # --json it still gives its plain text message on stderr, with exit
  # status 1 (verified against real PRs, not assumed). Catching that
  # separately before it counts as a real error: otherwise every adopted
  # project without CI gets a misleading "no network or no access" warning
  # on every merge. The text is English gh output and thus in principle
  # fragile across gh versions; if it changes, this falls back to the
  # generic fail-open message below — still allowing, just a less precise
  # reason.
  case "$error_text" in
    "no checks reported on"*)
      echo "warning: merge-guard found no CI checks configured for this PR and skips the CI check — merging without CI verification." >&2
      return 0 ;;
  esac

  if [ "$status" -ne 0 ]; then
    echo "warning: merge-guard couldn't consult the CI status (no network or no access) and skips the CI check." >&2
    [ -n "$error_text" ] && echo "$error_text" >&2
    return 0
  fi

  # Only python3 filters here, not gh's own -q: that syntax isn't
  # guaranteed stable across gh versions, and python3 is already a required
  # dependency of this guard (read-command.py). A parse error is now a
  # separate, loud outcome — no longer confused with "no problems found".
  local problems parse_status
  problems="$(printf '%s' "$output" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(1)
if not isinstance(data, list):
    sys.exit(1)
for item in data:
    bucket = item.get("bucket")
    if bucket not in ("pass", "skipping"):
        print(str(item.get("name")) + ": " + str(bucket))
')"
  parse_status=$?

  if [ "$parse_status" -ne 0 ]; then
    echo "warning: merge-guard couldn't interpret the CI status (unexpected output from gh pr checks) and skips the CI check." >&2
    return 0
  fi

  [ -n "$problems" ] || return 0

  block "gh pr merge while CI isn't green" \
"this PR has one or more checks that haven't succeeded or are still running:

       $problems

       Is this deliberate, use the explicit escape hatch — and report which
       check is being skipped:

         CLAUDE_WORKFLOW_MERGE_GUARD_OFF=1 <command>"
}

# Found via issue #223: `gh pr merge --squash` composes its squash commit's
# message from every constituent commit by default, not from the PR's own
# title/body. A stray closing keyword in an intermediate commit (a
# note-to-self at the time, not a real close instruction) therefore still
# reaches `main` and closes whatever issue it named — regardless of what the
# PR itself intended to close. Concretely: PR #217 had a commit reading
# "Closes #218" for unrelated, still-unfinished follow-up work; the PR's own
# title/body never mentioned #218, but the squash-merge commit did, and
# GitHub closed it. Third check in the same gate as the review-marker and
# CI checks above (called from check_merge_guard, after check_ci_guard) —
# not an independent switch: `CHANGES.md`'s `quality-review-before-merge`
# entry already establishes that a substantiated "no" there disables every
# check in this gate at once, not selectively, and this one is no
# exception. The escape hatch (AC6/merge_guard_off) is likewise inherited
# from the caller, not re-checked here.
#
# Issue #341: `closingIssuesReferences` is only populated by GitHub for a
# PR whose base is the repository's *default* branch (same root cause as
# #320/#318/#323) — so for a PR into a release branch, it's always empty,
# and every legitimate commit-level `Closes #N` was wrongly flagged as
# "stray", even when the PR's own title/body says the exact same thing.
# Fix: also scan the PR's own title+body with the same closing-keyword
# regex and treat any issue number found there as declared-by-the-PR too,
# same fallback pattern check-pr-issue-link.sh/model-record-gate.sh/
# issue-structure-gate.sh already established. This is a pure superset for
# the default-branch case (closingIssuesReferences already agrees with
# what the title/body says there, so the added numbers are the same ones)
# and the actual fix for the release-branch case.
#
# Issue #355: `gh pr view --json closingIssuesReferences,commits,title,body`
# is the one call in this epic's #318 defect class (GraphQL-backed, 403s
# from inside a Claude Code session in at least one confirmed run —
# wip/multi-agent-rollout/META-REVIEW-PILOT-3.md — even though a different
# session's own live calls here succeeded; the two sessions' `gh`
# versions/token scopes weren't distinguishable from this session alone,
# so the variance itself stays unexplained, same open question #355
# leaves on record) that was never migrated when its four siblings
# (compliance-evidence.sh, role-label-staleness.sh, model-record-gate.sh,
# issue-structure-gate.sh) all were. Rewritten REST-only, reusing
# model-record-gate.sh's own `gh api repos/{owner}/{repo}/...` pattern
# rather than re-deriving it. `closingIssuesReferences` itself is dropped
# instead of fetched via a separate REST call: the #341 comment above
# already established the title/body keyword scan as a pure superset of
# it (closingIssuesReferences never carried a number the title/body scan
# wouldn't also find), so there's nothing left it uniquely contributes.
#
# REST has no equivalent of `gh pr view <target>`'s own number/url/branch
# resolution, since `gh api repos/{owner}/{repo}/pulls/<n>` needs a plain
# PR number. `resolve_stray_closes_pr_number` below resolves every target
# shape `gh pr merge` accepts: a plain PR number or a `.../pull/<n>` URL is
# passed straight through; no target means the current branch, and any other
# target is a head branch name (`owner:branch` uses the part after the
# colon). Both branch cases go through one REST list-and-filter call on
# `.head.ref` (A44 1, #541). Zero matches, or more than one (fork PRs can
# share a head name), or a failing list call returns 1 and the caller fails
# open with its own warning, consistent with this guard's ground rule (when
# in doubt, allow); there is no first-match-wins guess between candidates.
#
# $1 is the same optional target (number/url/branch) as the other checks.
resolve_stray_closes_pr_number() {
  local target="$1" branch

  case "$target" in
    '')
      branch="$(git -C "$workdir" symbolic-ref --quiet --short HEAD 2>/dev/null)"
      [ -n "$branch" ] || return 1
      ;;
    *[!0-9]*)
      case "$target" in
        */pull/*)
          local number="${target##*/pull/}"
          number="${number%%/*}"
          number="${number%%\?*}"
          case "$number" in
            ''|*[!0-9]*) return 1 ;;
            *) printf '%s' "$number"; return 0 ;;
          esac
          ;;
        *)
          branch="${target#*:}"
          [ -n "$branch" ] || return 1
          ;;
      esac
      ;;
    *)
      printf '%s' "$target"
      return 0 ;;
  esac

  local list_part status
  list_part="$(cd "$workdir" && gh api "repos/{owner}/{repo}/pulls" --paginate --jq '.[] | (.number|tostring) + "\t" + .head.ref' 2>/dev/null)"
  status=$?
  [ "$status" -eq 0 ] || return 1

  local num ref found="" count=0
  while IFS=$'\t' read -r num ref; do
    if [ "$ref" = "$branch" ]; then
      found="$num"
      count=$((count + 1))
    fi
  done <<<"$list_part"

  # Exactly one match or nothing: an ambiguous head name is "in doubt".
  [ "$count" -eq 1 ] || return 1
  printf '%s' "$found"
  return 0
}

# Known, separate limitation this guard does NOT fix (issue #373/A15):
# GitHub's own auto-close-on-merge only fires for a PR whose base is the
# repo's default branch. A work-item PR merged into a release branch
# (not `main`) will not auto-close the issue it declares, the same way
# issue #308 had to be closed by hand. This guard's own closed-issue
# lookup (below) is unrelated — it stops an already-closed issue from
# being wrongly flagged as stray, it doesn't make GitHub close anything.
# See the `release-branch-workflow` skill for the operational guidance
# (closing the issue explicitly is the merger's own responsibility for a
# release-branch-base PR) until/unless this gets its own mechanism.
check_stray_closes_guard() {
  local target="$1"

  if ! command -v gh >/dev/null 2>&1; then
    echo "warning: merge-guard can't find gh and skips the stray-Closes check." >&2
    return 0
  fi

  local pr_number
  pr_number="$(resolve_stray_closes_pr_number "$target")"
  if [ -z "$pr_number" ]; then
    echo "warning: merge-guard couldn't consult the PR's commits (no network or no access) and skips the stray-Closes check." >&2
    return 0
  fi

  # Two REST calls, kept separate rather than one combined lookup: title/
  # body (a single object, `gh api repos/{owner}/{repo}/pulls/<n>`) and
  # commits (a paginated list, `.../pulls/<n>/commits`) are different REST
  # shapes. `\x01` separates fields within a record and `\x03` separates
  # the title/body header from the commits that follow (model-record-
  # gate.sh's own separator convention, reused); `\x02` closes each commit
  # record. stdout/stderr kept separate, not merged: a routine stderr line
  # from gh (an update notice, a deprecation warning) would otherwise
  # contaminate stdout and silently fail this check open — the same
  # stream-contamination bug check_ci_guard above was hardened against for
  # issue #81, and this check for PR #224's own review.
  local error_file
  error_file="$(mktemp)" 2>/dev/null || error_file=""

  local pr_part status error_text
  if [ -n "$error_file" ]; then
    pr_part="$(cd "$workdir" && gh api "repos/{owner}/{repo}/pulls/$pr_number" --jq '(.title // "") + "\u0001" + (.body // "") + "\u0003"' 2>"$error_file")"
    status=$?
    error_text="$(cat "$error_file" 2>/dev/null)"
  else
    pr_part="$(cd "$workdir" && gh api "repos/{owner}/{repo}/pulls/$pr_number" --jq '(.title // "") + "\u0001" + (.body // "") + "\u0003"' 2>/dev/null)"
    status=$?
    error_text=""
  fi

  if [ "$status" -ne 0 ]; then
    echo "warning: merge-guard couldn't consult the PR's commits (no network or no access) and skips the stray-Closes check." >&2
    [ -n "$error_text" ] && echo "$error_text" >&2
    [ -n "$error_file" ] && rm -f "$error_file"
    return 0
  fi

  local commits_part
  if [ -n "$error_file" ]; then
    commits_part="$(cd "$workdir" && gh api "repos/{owner}/{repo}/pulls/$pr_number/commits" --paginate --jq '.[] | (.sha // "") + "\u0001" + (.commit.message // "") + "\u0002"' 2>"$error_file")"
    status=$?
    error_text="$(cat "$error_file" 2>/dev/null)"
    rm -f "$error_file"
  else
    commits_part="$(cd "$workdir" && gh api "repos/{owner}/{repo}/pulls/$pr_number/commits" --paginate --jq '.[] | (.sha // "") + "\u0001" + (.commit.message // "") + "\u0002"' 2>/dev/null)"
    status=$?
    error_text=""
  fi

  if [ "$status" -ne 0 ]; then
    echo "warning: merge-guard couldn't consult the PR's commits (no network or no access) and skips the stray-Closes check." >&2
    [ -n "$error_text" ] && echo "$error_text" >&2
    return 0
  fi

  local output="$pr_part$commits_part"

  # GitHub's own closing-keyword grammar (close/closes/closed, fix/fixes/
  # fixed, resolve/resolves/resolved, case-insensitive, keyword followed by
  # either a colon — GitHub also accepts "Fixes: #123" — or plain
  # whitespace before the #) applied to every commit's message, compared
  # against what the PR itself declares it closes via the same keyword
  # scan applied to the PR's own title+body (#341/#355 — this is the only
  # source used now; see the comment above this function for why
  # closingIssuesReferences was dropped rather than fetched separately).
  # The colon form was missing from the first version of this check —
  # found during this very check's own pre-merge-review (round 3).
  local stray parse_status
  stray="$(printf '%s' "$output" | python3 -c '
import re, sys

raw = sys.stdin.read()
HEADER_SEP = "\x03"
if HEADER_SEP not in raw:
    sys.exit(1)
header, commits_blob = raw.split(HEADER_SEP, 1)

FIELD_SEP = "\x01"
if FIELD_SEP not in header:
    sys.exit(1)
title, body = header.split(FIELD_SEP, 1)

keyword = re.compile(r"\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)(?::\s*|\s+)#(\d+)", re.IGNORECASE)

closing = set()
pr_text = title + "\n" + body
for m in keyword.finditer(pr_text):
    closing.add(int(m.group(1)))

seen = set()
RECORD_SEP = "\x02"
for rec in commits_blob.split(RECORD_SEP):
    rec = rec.strip("\n")
    if not rec:
        continue
    if FIELD_SEP not in rec:
        continue
    sha, text = rec.split(FIELD_SEP, 1)
    sha = sha[:7]
    for m in keyword.finditer(text):
        n = int(m.group(1))
        if n not in closing and (n, sha) not in seen:
            seen.add((n, sha))
            print(str(n) + " " + sha)
')"
  parse_status=$?

  if [ "$parse_status" -ne 0 ]; then
    echo "warning: merge-guard couldn't interpret the PR's commits (unexpected output from gh api) and skips the stray-Closes check." >&2
    return 0
  fi

  [ -n "$stray" ] || return 0

  # A candidate stray that's already CLOSED can't be an unintended close —
  # that's the whole thing this check guards against (issue #370/A15). Cache
  # each issue number's state in two parallel lists (bash 3.2 has no
  # associative arrays) so a PR with several commits referencing the same
  # already-closed issue costs one `gh` call, not one per commit. On a
  # lookup failure (no network, issue deleted), keep the candidate flagged —
  # the opposite fail-open direction from the rest of this guard, deliberate
  # here: silently dropping a real stray reference defeats the check's own
  # purpose, so "can't confirm closed" stays conservative, not permissive.
  local checked_nums=() checked_states=() n sha issue_state i found
  local summary line
  summary=""
  while IFS=' ' read -r n sha; do
    [ -n "$n" ] || continue

    found=0
    for ((i = 0; i < ${#checked_nums[@]}; i++)); do
      if [ "${checked_nums[$i]}" = "$n" ]; then
        issue_state="${checked_states[$i]}"
        found=1
        break
      fi
    done
    if [ "$found" -eq 0 ]; then
      issue_state="$(cd "$workdir" && gh issue view "$n" --json state --jq .state 2>/dev/null)"
      checked_nums+=("$n")
      checked_states+=("$issue_state")
    fi

    [ "$issue_state" = "CLOSED" ] && continue

    summary="$summary
       #$n (commit $sha)"
  done <<<"$stray"

  # Every candidate turned out already-closed (or $stray was non-empty only
  # by its trailing newline) — nothing left to block on.
  [ -n "$summary" ] || return 0

  block "gh pr merge with a stray commit-level Closes" \
"one or more commits on this PR reference an issue with a closing keyword
       that the PR's own title/body does not also close. Merging would close
       it for real anyway: gh pr merge --squash composes its message from
       every constituent commit by default, not just the PR's title/body.
$summary

       Fix the commit message, or add the issue to the PR itself if the
       close is genuinely intended. If this is deliberate, use the explicit
       escape hatch:

         CLAUDE_WORKFLOW_MERGE_GUARD_OFF=1 <command>"
}

# --- per command in the chain -----------------------------------------------
# Only segments that themselves start with `git` are judged. So
# `echo "never use git reset --hard"` blocks nothing: `git` isn't at the
# front there. Is this a short-flag cluster (`-fd`, `-D`) that contains
# <letter>? Long options don't count: `--exclude=foo` contains an `f`, but
# isn't a `-f`. That distinction isn't cosmetic — without it, the guard
# would block `git clean -n --exclude=foo`, a dry run that discards nothing.
short_flag_has() {
  local token="$1" letter="$2"
  case "$token" in
    --*) return 1 ;;
    -*)  ;;
    *)   return 1 ;;
  esac
  local cluster="${token%%=*}"
  case "$cluster" in
    *"$letter"*) return 0 ;;
    *) return 1 ;;
  esac
}

# Scan only actual commit/push options; their operands remain data. The
# shell reader already owns quoting and segmentation. Keep Git policy here.
check_hook_bypass() {
  local sub="$1" token cluster letter
  shift
  while [ $# -gt 0 ]; do
    token="$1"
    shift
    case "$token" in
      --) return 0 ;;
      --no-verify)
        block "git $sub $token" "this bypasses native Git hooks; use the explicit workflow escape hatch." ;;
      --*=*) continue ;;
      --*)
        case "$sub:$token" in
          commit:--message|commit:--file|commit:--author|commit:--date|commit:--reedit-message|commit:--reuse-message|commit:--fixup|commit:--squash|commit:--trailer|commit:--template|commit:--cleanup|commit:--pathspec-from-file|push:--repo|push:--recurse-submodules|push:--receive-pack|push:--exec|push:--push-option)
            [ $# -gt 0 ] && shift ;;
        esac ;;
      -?*)
        cluster="${token#-}"
        while [ -n "$cluster" ]; do
          letter="${cluster:0:1}"
          cluster="${cluster:1}"
          if [ "$sub:$letter" = "commit:n" ]; then
            block "git $sub $token" "this bypasses native Git hooks (-n); use the explicit workflow escape hatch."
          fi
          case "$sub:$letter" in
            commit:m|commit:F|commit:c|commit:C|commit:t|push:o)
              if [ -z "$cluster" ] && [ $# -gt 0 ]; then shift; fi
              break ;;
            commit:S|commit:u)
              # These optional values must be attached, never the next token.
              break ;;
          esac
        done ;;
    esac
  done
}

# Does this argument point at the entire working directory? `.`, `./`, and
# `./.` are the same place.
is_whole_workdir() {
  case "$1" in
    .|./|./.) return 0 ;;
    *) return 1 ;;
  esac
}

# Gets the tokens of one segment as arguments — already stripped of quotes.
judge_segment() {
  [ $# -gt 0 ] || return 0

  # Only relevant for the gh path below; reset here so every segment starts
  # with a clean slate. Deliberately no `return 0` when setting it (see
  # below): that would skip this entire segment, including a destructive
  # git command that happens to start with the same var prefix.
  merge_guard_off=0

  # Environment variables before the command belong to the call, not to a
  # different program: `GIT_TRACE=1 git reset --hard` is still a git
  # command. Without this step, any var prefix would bypass the whole
  # guard.
  while [ $# -gt 0 ]; do
    case "$1" in
      CLAUDE_WORKFLOW_GUARDRAILS_OFF=*)
        # The escape hatch as the block message prescribes it. It must be
        # able to appear in the command text: a command that hasn't started
        # yet can, by definition, not influence this guard's environment.
        echo "warning: git-guardrails is explicitly turned off for this command." >&2
        return 0 ;;
      CLAUDE_WORKFLOW_MERGE_GUARD_OFF=*)
        # AC6 (F8): a deliberate, loud escape hatch specific to the merge
        # guard — separate from the destructive-git escape hatch above.
        # Only setting a flag, not returning immediately: this command
        # could also (still) be a destructive git command, and that must
        # still be judged as usual. check_merge_guard reads the flag
        # further down.
        echo "warning: the merge guard (up-to-date check, review marker and CI status) is explicitly skipped for this command." >&2
        merge_guard_off=1
        shift ;;
      GH_HOST=*)
        # Command-local host selection overrides the inherited default,
        # but must be restored before judging the next segment.
        local GH_HOST="${1#GH_HOST=}"
        shift ;;
      [A-Za-z_]*=*) shift ;;
      *) break ;;
    esac
  done

  case "${1:-}" in
    git|gh) ;;
    *) return 0 ;;
  esac
  local program="$1"
  shift

  if [ "$program" = "gh" ]; then
    judge_gh_segment "$@"
    return
  fi
  [ "$merge_only" -eq 0 ] || return 0

  # Skipping global git options. The path-determining ones are remembered;
  # they go along to the branch check so git itself determines the repo.
  path_options=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -C|--git-dir|--work-tree)
        [ $# -ge 2 ] || return 0
        path_options+=("$1" "$2")
        shift 2 ;;
      --git-dir=*|--work-tree=*)
        path_options+=("$1")
        shift ;;
      -c)
        [ $# -ge 2 ] || return 0
        shift 2 ;;
      -*) shift ;;
      *)  break ;;
    esac
  done

  local sub="${1:-}"
  [ -n "$sub" ] || return 0
  shift

  case "$sub" in
    commit|push) check_hook_bypass "$sub" "$@" ;;
  esac

  local arg
  case "$sub" in
    commit)
      # Work should originate on a feature branch, not on main. The guard
      # used to only block the push; then you'd run through a whole session
      # and only discover it at the end, with every commit on main.
      #
      # Exception: a repo with no commits. The very first commit of a new
      # project is, by definition, on main, and that step is documented that
      # way in the `adopt-workflow` skill under "Setting up a new (related)
      # project" (reached from WORKFLOW.md's routing table).
      if git -C "$workdir" rev-parse --verify HEAD >/dev/null 2>&1; then
        if is_main "$(current_branch)"; then
          block "git commit on main" "${REASON_COMMIT_ON_MAIN:-main gets its changes via a PR. Make a branch first.}"
        fi
      fi ;;
    reset)
      for arg in "$@"; do
        [ "$arg" = "--hard" ] && block "git reset --hard" \
          "this irrevocably discards your work in the working tree."
      done ;;
    clean)
      for arg in "$@"; do
        if [ "$arg" = "--force" ] || short_flag_has "$arg" f; then
          block "git clean $arg" "this irrevocably removes untracked files."
        fi
      done ;;
    branch)
      local has_delete=0 has_force=0
      for arg in "$@"; do
        short_flag_has "$arg" D && block "git branch $arg" \
          "this deletes a branch even if it isn't merged; use -d."
        [ "$arg" = "--delete" ] && has_delete=1
        { [ "$arg" = "--force" ] || short_flag_has "$arg" f; } && has_force=1
      done
      if [ "$has_delete" -eq 1 ] && [ "$has_force" -eq 1 ]; then
        block "git branch --delete --force" \
          "this deletes a branch even if it isn't merged; use only --delete."
      fi ;;
    checkout|restore)
      for arg in "$@"; do
        is_whole_workdir "$arg" && block "git $sub $arg" \
          "this discards all uncommitted changes in the working tree."
      done
      if [ "$sub" = "checkout" ]; then
        local args=("$@") new_branch="" idx
        for ((idx = 0; idx < ${#args[@]}; idx++)); do
          case "${args[$idx]}" in
            -b|-B) new_branch="${args[$((idx + 1))]:-}" ;;
          esac
        done
        [ -n "$new_branch" ] && check_branch_creation "$new_branch" "checkout"
      fi ;;
    switch)
      local args=("$@") new_branch="" idx
      for ((idx = 0; idx < ${#args[@]}; idx++)); do
        case "${args[$idx]}" in
          -c|-C|--create|--force-create) new_branch="${args[$((idx + 1))]:-}" ;;
          --create=*) new_branch="${args[$idx]#--create=}" ;;
          --force-create=*) new_branch="${args[$idx]#--force-create=}" ;;
        esac
      done
      [ -n "$new_branch" ] && check_branch_creation "$new_branch" "switch" ;;
    push)
      local refspecs=() remote_seen=0
      for arg in "$@"; do
        case "$arg" in
          --all|--mirror)
            block "git push $arg" \
              "this pushes all branches, including main — regardless of where you are now." ;;
          -*) continue ;;
        esac
        if [ "$remote_seen" -eq 0 ]; then
          remote_seen=1
        else
          refspecs+=("$arg")
        fi
      done

      if [ "${#refspecs[@]}" -eq 0 ]; then
        # No refspec: where this goes depends on the current branch.
        is_main "$(current_branch)" && block "git push from main" \
          "main is checked out, so this push goes to main. Work on a feature branch."
        return 0
      fi

      for arg in "${refspecs[@]}"; do
        local target; target="$(refspec_target "$arg")"
        if [ "$target" = "HEAD" ]; then
          is_main "$(current_branch)" && block "git push origin HEAD from main" \
            "HEAD points to main here, so this push goes to main."
        elif is_main "$target"; then
          block "git push to main" "${REASON_PUSH_TO_MAIN:-main gets its changes via a PR, not via a direct push.}"
        fi
      done ;;
  esac
}

# Reading the token stream. Records are NUL-separated and carry a type
# character: `c` the working directory, `t` a token, `e` the end of a
# segment. Defaults to the current working directory; the stream overwrites
# it as the first record. That order is guaranteed, but the fallback belongs
# before it: a segment is already judged during the loop.
workdir="$PWD"
tokens=()
path_options=()

while IFS= read -r -d '' record; do
  # Substring expansion, not pattern matching: a value may contain glob
  # characters, and those would make a `%%` construct misfire.
  kind="${record:0:1}"
  value="${record:1}"
  case "$kind" in
    c) [ -n "$value" ] && workdir="$value" ;;
    t) tokens+=("$value") ;;
    e)
      if [ "${#tokens[@]}" -gt 0 ]; then
        judge_segment "${tokens[@]}"
      fi
      tokens=() ;;
  esac
done < "$stream"

exit 0
