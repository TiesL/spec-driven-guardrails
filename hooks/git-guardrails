#!/usr/bin/env bash
# hooks/git-guardrails — PreToolUse guard against destructive git commands,
# and (W10b, F8) the merge guard on `gh pr merge`.
#
# "Never directly to main" was an agreement with no lock: branch protection
# requires a paid plan on private repos. This is that lock.
#
# Second case, same mechanism: `gh pr merge` is blocked if the PR doesn't
# carry a machine-recognizable review marker (which `pre-merge-review`
# places, F11), or if the PR has checks that haven't passed (issue #81 — CI
# failed six runs in a row, unnoticed, because nothing in the merge flow
# looked at it). Fails open without `gh` or network — neither check is ever
# the command that locks up a session. A substantiated `no` on the
# `quality-review-before-merge` row in `WORKFLOW-ADOPTION.md` turns off
# both checks for that project, read locally, with no network call.
#
# Contract (Claude Code PreToolUse): JSON on stdin with `tool_name` and
# `tool_input.command`; exit status 2 blocks and stderr becomes the message
# to Claude. Any other status lets the command through.
#
# Ground rule: when in doubt, allow. A missed case is annoying; a false
# positive blocks work in four projects at once and reaches them without a
# re-adoption, because the hook configuration is symlinked.
#
# Bash 3.2-compatible: no declare -A, no mapfile, no ${var,,}.

set -uo pipefail

# Deliberate escape hatch. A guard without an escape hatch eventually gets
# bypassed by editing the script instead, and that's worse than a guard you
# turn off explicitly.
if [ -n "${CLAUDE_WORKFLOW_GUARDRAILS_OFF:-}" ]; then
  echo "warning: git-guardrails is disabled via CLAUDE_WORKFLOW_GUARDRAILS_OFF." >&2
  exit 0
fi

# Reading with a bash redirect instead of `cat`: the guard must still be
# able to give its warning even on a bare PATH, and that doesn't work if it
# already trips over a missing utility.
input="$(</dev/stdin)"
[ -n "$input" ] || exit 0

own_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
reader="$own_dir/read-command.py"

# MAIN_BRANCH and the REDEN_* texts come from rules.sh, shared with the
# native git hooks (W26) — which branch is protected and what the message
# says lives in one place this way. If the file is missing (broken
# checkout), this falls back to the hardcoded "main": when in doubt, allow
# also applies here to the guard's own infrastructure.
if [ -r "$own_dir/rules.sh" ]; then
  # shellcheck source=rules.sh
  . "$own_dir/rules.sh"
fi
MAIN_BRANCH="${MAIN_BRANCH:-main}"

if ! command -v python3 >/dev/null 2>&1; then
  echo "warning: git-guardrails needs python3 to read the command" >&2
  echo "and so lets this command through. Install python3 to make the guard work." >&2
  exit 0
fi
if [ ! -r "$reader" ]; then
  echo "warning: git-guardrails is missing $reader and lets this command through." >&2
  exit 0
fi

# The reader is the only thing that decides how the command is read: JSON,
# heredocs, quoting, and tokenization. This guard only ever compares tokens.
# Without that separation, bash had to emulate quoting, and that blocked
# innocent commands — a `;` in a commit message split the command into
# pieces.
#
# Via a file, not via $(...): a token stream is NUL-separated and command
# substitution discards NUL bytes.
stream="$(mktemp)" || exit 0
trap 'rm -f "$stream"' EXIT

printf '%s' "$input" | python3 "$reader" > "$stream"
case $? in
  0) ;;
  4) exit 0 ;;   # not a Bash call, or no command
  *) exit 0 ;;   # unreadable: don't guess at a reading
esac

# --- helper functions -------------------------------------------------------
# The path-determining options of the judged command come along, so git
# itself computes which repo is meant. `git -C ../other push origin HEAD`
# acts on that other repo, not on the directory the session happens to be
# in.
#
# Deliberately only `-C`, `--git-dir`, and `--work-tree`: those determine the
# path. Other global options come from the same untrusted text as the
# command itself and are not passed through. That means the guard misses
# `-c core.worktree=<path>` — the same effect via the config route.
# Deliberately accepted: opening up that case requires an allowlist of safe
# config keys, and a missed case weighs less here than reopening that
# question.
#
# As an argv array, never as a composed string: letting a shell read that
# again brings back exactly the word splitting this guard removes.
# `symbolic-ref` and not `rev-parse --abbrev-ref`: the latter returns the
# literal text "HEAD" instead of the branch name on a repo with no commits.
# That happens to work here — "HEAD" is simply never "main" — but it's a
# coincidence, and whoever ever "fixes" that call would silently block the
# first commit of every new project. symbolic-ref also names the branch
# before the first commit; the exception for that lives explicitly at
# `commit` and doesn't rely on a coincidence.
#
# A detached HEAD yields an empty name, and that falls, via `is_main`, in
# the safe direction: don't block.
current_branch() {
  if [ "${#path_options[@]}" -gt 0 ]; then
    git -C "$workdir" "${path_options[@]}" symbolic-ref --short HEAD 2>/dev/null
  else
    git -C "$workdir" symbolic-ref --short HEAD 2>/dev/null
  fi
}

block() {
  echo "Blocked by git-guardrails: $1" >&2
  echo "" >&2
  echo "Reason: $2" >&2
  echo "" >&2
  echo "If this is really necessary, turn off the guard explicitly for this one command:" >&2
  echo "  CLAUDE_WORKFLOW_GUARDRAILS_OFF=1 <command>" >&2
  exit 2
}

# Determines the destination of one refspec. `feature:main` yields `main`,
# `+main` yields `main`, `:main` (delete) too.
refspec_target() {
  local spec="${1#+}"
  case "$spec" in
    *:*) echo "${spec##*:}" ;;
    *)   echo "$spec" ;;
  esac
}

is_main() {
  case "$1" in
    "$MAIN_BRANCH"|"refs/heads/$MAIN_BRANCH") return 0 ;;
    *) return 1 ;;
  esac
}

# --- issue-first branch guard (F19, issue #212) -----------------------------
# A new feature/fix branch must name the issue it implements
# (feature/123-short-desc): requiring the number forces the issue to exist
# before the branch can even be named. $1 is the branch name being created
# (from `checkout -b`/`switch -c`); $2 is the subcommand, for the message.
check_branch_creation() {
  local branch="$1" sub_cmd="$2"
  [ -n "$branch" ] || return 0

  case "$branch" in
    feature/*|fix/*) ;;
    *) return 0 ;;
  esac

  if ! printf '%s' "$branch" | grep -qE "${BRANCH_ISSUE_PATTERN:-^$}"; then
    block "git $sub_cmd $branch" "${REASON_BRANCH_NO_ISSUE:-every feature/fix branch names the issue it implements, e.g. feature/123-short-desc.}"
  fi

  # AC3: fail open without gh — same rule as the merge guard below.
  if ! command -v gh >/dev/null 2>&1; then
    echo "warning: issue-first branch guard can't find gh and skips the issue-existence check." >&2
    return 0
  fi

  local issue_number state status
  issue_number="${branch#*/}"
  issue_number="${issue_number%%-*}"

  state="$(gh issue view "$issue_number" --json state --jq .state 2>/dev/null)"
  status=$?
  if [ "$status" -ne 0 ] || [ -z "$state" ]; then
    echo "warning: issue-first branch guard couldn't consult issue #$issue_number (no network or no access) and skips the check." >&2
    return 0
  fi

  if [ "$state" != "OPEN" ]; then
    block "git $sub_cmd $branch" \
"issue #$issue_number is $state, not open — a branch must reference an open
       issue.

       Is this deliberate, use the explicit escape hatch:
         CLAUDE_WORKFLOW_GUARDRAILS_OFF=1 <command>"
  fi
}

# --- the merge guard (W10b, F8) ---------------------------------------------
# The marker that `pre-merge-review` (F11) literally prescribes. Deliberately
# duplicated here as a string, not read from SKILL.md: this guard must not
# depend on the presence or shape of a skill file in the project.
MERGE_REVIEW_MARKER='<!-- pre-merge-review:done -->'

# Judges `gh ...` segments. Only `pr merge` is relevant; everything else
# passes through untouched.
#
# Value flags of "gh pr merge" that claim the *next* token (source: `gh pr
# merge --help`). Without this list, `--body "text"`, for example, would
# shift into the target position (number/url/branch), and the guard would
# judge the wrong PR instead of the current branch's PR — exactly the case
# where `gh pr view <body text>` fails and the guard, via the fail-open
# path, lets a PR without a marker through anyway.
judge_gh_segment() {
  local arg

  local positions=()
  while [ $# -gt 0 ]; do
    arg="$1"
    case "$arg" in
      -R|--repo|-R*|--repo=*)
        # A different repository than the working directory. When in doubt,
        # allow: that requires knowledge about a repo this guard doesn't
        # have, and a missed case weighs less here than a false-positive
        # block.
        return 0 ;;
      -A|--author-email|-b|--body|-F|--body-file|--match-head-commit|-t|--subject)
        [ $# -ge 2 ] || return 0
        shift 2
        continue ;;
      --author-email=*|--body=*|--body-file=*|--match-head-commit=*|--subject=*)
        shift
        continue ;;
      -*)
        shift
        continue ;;
      *)
        positions+=("$arg")
        shift ;;
    esac
  done

  [ "${positions[0]:-}" = "pr" ] && [ "${positions[1]:-}" = "merge" ] || return 0

  check_merge_guard "${positions[2]:-}"
}

# AC2–AC6 (F8/S15–S18): the actual judgment on one `gh pr merge`.
# $1 is the optional target (number/url/branch) that stood after "merge".
check_merge_guard() {
  local target="$1"

  # AC6: the explicit escape hatch, set in judge_segment (already
  # loudly reported).
  [ "${merge_guard_off:-0}" -eq 1 ] && return 0

  # AC5: a substantiated `no` on quality-review-before-merge turns it off —
  # local grep, before any gh call, so no network. Checks both the new and
  # the pre-migration (W42/#114) filename/ID/value, since a project that
  # hasn't migrated yet still answers with the old vocabulary.
  local project_root answers line answer
  project_root="$(git -C "$workdir" rev-parse --show-toplevel 2>/dev/null)"
  [ -n "$project_root" ] || project_root="$workdir"
  answers="$project_root/WORKFLOW-ADOPTION.md"
  if [ -f "$answers" ]; then
    line="$(grep -m1 '^| *quality-review-before-merge *|' "$answers")"
    if [ -n "$line" ]; then
      answer="$(printf '%s\n' "$line" | awk -F'|' '{a=$3; gsub(/^[ \t]+|[ \t]+$/, "", a); print a}')"
      [ "$answer" = "no" ] && return 0
    fi
  fi
  answers="$project_root/WORKFLOW-ADOPTIE.md"
  if [ -f "$answers" ]; then
    line="$(grep -m1 '^| *kwaliteitsreview-voor-merge *|' "$answers")"
    if [ -n "$line" ]; then
      answer="$(printf '%s\n' "$line" | awk -F'|' '{a=$3; gsub(/^[ \t]+|[ \t]+$/, "", a); print a}')"
      [ "$answer" = "nee" ] && return 0
    fi
  fi

  # AC4: fail open without gh.
  if ! command -v gh >/dev/null 2>&1; then
    echo "warning: merge-guard can't find gh and skips the review check." >&2
    return 0
  fi

  local call output status
  if [ -n "$target" ]; then
    call=(gh pr view "$target" --json comments)
  else
    call=(gh pr view --json comments)
  fi
  output="$(cd "$workdir" && "${call[@]}" 2>&1)"
  status=$?

  # AC4: fail open without network (or any other reason gh can't consult
  # the PR — when in doubt, allow, the same ground rule as everywhere else
  # in this script).
  if [ "$status" -ne 0 ]; then
    echo "warning: merge-guard couldn't consult the PR (no network or no access) and skips the review check." >&2
    echo "$output" >&2
    return 0
  fi

  case "$output" in
    *"$MERGE_REVIEW_MARKER"*) ;;
    *)
      block "gh pr merge without a review marker" \
"this PR doesn't carry the pre-merge-review marker. Run that skill first and
       leave the findings (with marker) on the PR.

       Is this deliberate, use the explicit escape hatch — and report which
       check is being skipped:

         CLAUDE_WORKFLOW_MERGE_GUARD_OFF=1 <command>" ;;
  esac

  check_ci_guard "$target"
  check_stray_closes_guard "$target"
}

# Found while reviewing PR #80 (issue #81): CI had been systematically
# failing since PR #76, six runs in a row, and nothing in the merge flow
# saw it — no branch protection (private repo, no paid plan), and
# `gh pr merge` doesn't warn on failing checks. Same mechanism and
# fail-open philosophy as the review-marker check above, second check in
# the same gate.
#
# $1 is the same optional target (number/url/branch) as the marker check.
check_ci_guard() {
  local target="$1"

  local call output status
  if [ -n "$target" ]; then
    call=(gh pr checks "$target" --json "bucket,name")
  else
    call=(gh pr checks --json "bucket,name")
  fi

  # stdout and stderr kept separate, not merged with 2>&1: a routine stderr
  # line from gh (an update notice, a deprecation warning) would otherwise
  # contaminate the JSON on stdout. json.load would then fail, an earlier
  # broad except Exception caught that and so let a red PR through in
  # silence — no warning, just an empty findings list. Exactly the same
  # failure class as the bug this PR fixes, now prevented by separating the
  # streams instead of trusting clean output.
  #
  # gh's own --json normalizes the exit status of "checks failing/still
  # running" (normally 1 and 8 respectively, see `gh help exit-codes`) back
  # to 0: the call itself succeeded after all, only the content of the
  # checks isn't green. A non-zero status here therefore always means the
  # lookup itself failed (no network, no PR found, no access) — except the
  # case below, where gh returns its plain error message even with --json.
  local error_file error_text
  error_file="$(mktemp)" 2>/dev/null || error_file=""
  if [ -n "$error_file" ]; then
    output="$(cd "$workdir" && "${call[@]}" 2>"$error_file")"
    status=$?
    error_text="$(cat "$error_file" 2>/dev/null)"
    rm -f "$error_file"
  else
    output="$(cd "$workdir" && "${call[@]}" 2>/dev/null)"
    status=$?
    error_text=""
  fi

  # No checks reported is not an error and not a red flag: CI is optional
  # (see F6). gh doesn't return that case as an empty JSON list — even with
  # --json it still gives its plain text message on stderr, with exit
  # status 1 (verified against real PRs, not assumed). Catching that
  # separately before it counts as a real error: otherwise every adopted
  # project without CI gets a misleading "no network or no access" warning
  # on every merge. The text is English gh output and thus in principle
  # fragile across gh versions; if it changes, this falls back to the
  # generic fail-open message below — still allowing, just a less precise
  # reason.
  case "$error_text" in
    "no checks reported on"*) return 0 ;;
  esac

  if [ "$status" -ne 0 ]; then
    echo "warning: merge-guard couldn't consult the CI status (no network or no access) and skips the CI check." >&2
    [ -n "$error_text" ] && echo "$error_text" >&2
    return 0
  fi

  # Only python3 filters here, not gh's own -q: that syntax isn't
  # guaranteed stable across gh versions, and python3 is already a required
  # dependency of this guard (read-command.py). A parse error is now a
  # separate, loud outcome — no longer confused with "no problems found".
  local problems parse_status
  problems="$(printf '%s' "$output" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(1)
if not isinstance(data, list):
    sys.exit(1)
for item in data:
    bucket = item.get("bucket")
    if bucket not in ("pass", "skipping"):
        print(str(item.get("name")) + ": " + str(bucket))
')"
  parse_status=$?

  if [ "$parse_status" -ne 0 ]; then
    echo "warning: merge-guard couldn't interpret the CI status (unexpected output from gh pr checks) and skips the CI check." >&2
    return 0
  fi

  [ -n "$problems" ] || return 0

  block "gh pr merge while CI isn't green" \
"this PR has one or more checks that haven't succeeded or are still running:

       $problems

       Is this deliberate, use the explicit escape hatch — and report which
       check is being skipped:

         CLAUDE_WORKFLOW_MERGE_GUARD_OFF=1 <command>"
}

# Found via issue #223: `gh pr merge --squash` composes its squash commit's
# message from every constituent commit by default, not from the PR's own
# title/body. A stray closing keyword in an intermediate commit (a
# note-to-self at the time, not a real close instruction) therefore still
# reaches `main` and closes whatever issue it named — regardless of what the
# PR itself intended to close. Concretely: PR #217 had a commit reading
# "Closes #218" for unrelated, still-unfinished follow-up work; the PR's own
# title/body never mentioned #218, but the squash-merge commit did, and
# GitHub closed it. Third check in the same gate as the review-marker and
# CI checks above (called from check_merge_guard, after check_ci_guard) —
# not an independent switch: `CHANGES.md`'s `quality-review-before-merge`
# entry already establishes that a substantiated "no" there disables every
# check in this gate at once, not selectively, and this one is no
# exception. The escape hatch (AC6/merge_guard_off) is likewise inherited
# from the caller, not re-checked here.
#
# $1 is the same optional target (number/url/branch) as the other checks.
check_stray_closes_guard() {
  local target="$1"

  if ! command -v gh >/dev/null 2>&1; then
    echo "warning: merge-guard can't find gh and skips the stray-Closes check." >&2
    return 0
  fi

  local call output status
  if [ -n "$target" ]; then
    call=(gh pr view "$target" --json closingIssuesReferences,commits)
  else
    call=(gh pr view --json closingIssuesReferences,commits)
  fi

  # stdout and stderr kept separate, not merged: a routine stderr line from
  # gh (an update notice, a deprecation warning) would otherwise contaminate
  # the JSON on stdout and silently fail this check open — the exact
  # stream-contamination bug check_ci_guard above was hardened against for
  # issue #81. Found during this check's own pre-merge-review (PR #224).
  local error_file error_text
  error_file="$(mktemp)" 2>/dev/null || error_file=""
  if [ -n "$error_file" ]; then
    output="$(cd "$workdir" && "${call[@]}" 2>"$error_file")"
    status=$?
    error_text="$(cat "$error_file" 2>/dev/null)"
    rm -f "$error_file"
  else
    output="$(cd "$workdir" && "${call[@]}" 2>/dev/null)"
    status=$?
    error_text=""
  fi

  if [ "$status" -ne 0 ]; then
    echo "warning: merge-guard couldn't consult the PR's commits (no network or no access) and skips the stray-Closes check." >&2
    [ -n "$error_text" ] && echo "$error_text" >&2
    return 0
  fi

  # GitHub's own closing-keyword grammar (close/closes/closed, fix/fixes/
  # fixed, resolve/resolves/resolved, case-insensitive) applied to every
  # commit's headline+body, compared against the PR's own
  # closingIssuesReferences — the same field link 3 already treats as
  # authoritative for what this PR itself intends to close.
  local stray parse_status
  stray="$(printf '%s' "$output" | python3 -c '
import json, re, sys

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(1)

closing = set()
for ref in (data.get("closingIssuesReferences") or []):
    n = ref.get("number")
    if n is not None:
        closing.add(int(n))

keyword = re.compile(r"\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\s+#(\d+)", re.IGNORECASE)

seen = set()
for commit in (data.get("commits") or []):
    text = (commit.get("messageHeadline") or "") + "\n" + (commit.get("messageBody") or "")
    sha = (commit.get("oid") or "")[:7]
    for m in keyword.finditer(text):
        n = int(m.group(1))
        if n not in closing and (n, sha) not in seen:
            seen.add((n, sha))
            print(str(n) + " " + sha)
')"
  parse_status=$?

  if [ "$parse_status" -ne 0 ]; then
    echo "warning: merge-guard couldn't interpret the PR's commits (unexpected output from gh pr view) and skips the stray-Closes check." >&2
    return 0
  fi

  [ -n "$stray" ] || return 0

  local summary line
  summary=""
  while IFS=' ' read -r n sha; do
    [ -n "$n" ] || continue
    summary="$summary
       #$n (commit $sha)"
  done <<<"$stray"

  block "gh pr merge with a stray commit-level Closes" \
"one or more commits on this PR reference an issue with a closing keyword
       that the PR's own title/body does not also close. Merging would close
       it for real anyway: gh pr merge --squash composes its message from
       every constituent commit by default, not just the PR's title/body.
$summary

       Fix the commit message, or add the issue to the PR itself if the
       close is genuinely intended. If this is deliberate, use the explicit
       escape hatch:

         CLAUDE_WORKFLOW_MERGE_GUARD_OFF=1 <command>"
}

# --- per command in the chain -----------------------------------------------
# Only segments that themselves start with `git` are judged. So
# `echo "never use git reset --hard"` blocks nothing: `git` isn't at the
# front there. Is this a short-flag cluster (`-fd`, `-D`) that contains
# <letter>? Long options don't count: `--exclude=foo` contains an `f`, but
# isn't a `-f`. That distinction isn't cosmetic — without it, the guard
# would block `git clean -n --exclude=foo`, a dry run that discards nothing.
short_flag_has() {
  local token="$1" letter="$2"
  case "$token" in
    --*) return 1 ;;
    -*)  ;;
    *)   return 1 ;;
  esac
  local cluster="${token%%=*}"
  case "$cluster" in
    *"$letter"*) return 0 ;;
    *) return 1 ;;
  esac
}

# Does this argument point at the entire working directory? `.`, `./`, and
# `./.` are the same place.
is_whole_workdir() {
  case "$1" in
    .|./|./.) return 0 ;;
    *) return 1 ;;
  esac
}

# Gets the tokens of one segment as arguments — already stripped of quotes.
judge_segment() {
  [ $# -gt 0 ] || return 0

  # Only relevant for the gh path below; reset here so every segment starts
  # with a clean slate. Deliberately no `return 0` when setting it (see
  # below): that would skip this entire segment, including a destructive
  # git command that happens to start with the same var prefix.
  merge_guard_off=0

  # Environment variables before the command belong to the call, not to a
  # different program: `GIT_TRACE=1 git reset --hard` is still a git
  # command. Without this step, any var prefix would bypass the whole
  # guard.
  while [ $# -gt 0 ]; do
    case "$1" in
      CLAUDE_WORKFLOW_GUARDRAILS_OFF=*)
        # The escape hatch as the block message prescribes it. It must be
        # able to appear in the command text: a command that hasn't started
        # yet can, by definition, not influence this guard's environment.
        echo "warning: git-guardrails is explicitly turned off for this command." >&2
        return 0 ;;
      CLAUDE_WORKFLOW_MERGE_GUARD_OFF=*)
        # AC6 (F8): a deliberate, loud escape hatch specific to the merge
        # guard — separate from the destructive-git escape hatch above.
        # Only setting a flag, not returning immediately: this command
        # could also (still) be a destructive git command, and that must
        # still be judged as usual. check_merge_guard reads the flag
        # further down.
        echo "warning: the merge guard (review marker and CI status) is explicitly skipped for this command." >&2
        merge_guard_off=1
        shift ;;
      [A-Za-z_]*=*) shift ;;
      *) break ;;
    esac
  done

  case "${1:-}" in
    git|gh) ;;
    *) return 0 ;;
  esac
  local program="$1"
  shift

  if [ "$program" = "gh" ]; then
    judge_gh_segment "$@"
    return
  fi

  # Skipping global git options. The path-determining ones are remembered;
  # they go along to the branch check so git itself determines the repo.
  path_options=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -C|--git-dir|--work-tree)
        [ $# -ge 2 ] || return 0
        path_options+=("$1" "$2")
        shift 2 ;;
      --git-dir=*|--work-tree=*)
        path_options+=("$1")
        shift ;;
      -c)
        [ $# -ge 2 ] || return 0
        shift 2 ;;
      -*) shift ;;
      *)  break ;;
    esac
  done

  local sub="${1:-}"
  [ -n "$sub" ] || return 0
  shift

  local arg
  case "$sub" in
    commit)
      # Work should originate on a feature branch, not on main. The guard
      # used to only block the push; then you'd run through a whole session
      # and only discover it at the end, with every commit on main.
      #
      # Exception: a repo with no commits. The very first commit of a new
      # project is, by definition, on main, and that step is documented that
      # way in the `adopt-workflow` skill under "Setting up a new (related)
      # project" (reached from WORKFLOW.md's routing table).
      if git -C "$workdir" rev-parse --verify HEAD >/dev/null 2>&1; then
        if is_main "$(current_branch)"; then
          block "git commit on main" "${REASON_COMMIT_ON_MAIN:-main gets its changes via a PR. Make a branch first.}"
        fi
      fi ;;
    reset)
      for arg in "$@"; do
        [ "$arg" = "--hard" ] && block "git reset --hard" \
          "this irrevocably discards your work in the working tree."
      done ;;
    clean)
      for arg in "$@"; do
        if [ "$arg" = "--force" ] || short_flag_has "$arg" f; then
          block "git clean $arg" "this irrevocably removes untracked files."
        fi
      done ;;
    branch)
      local has_delete=0 has_force=0
      for arg in "$@"; do
        short_flag_has "$arg" D && block "git branch $arg" \
          "this deletes a branch even if it isn't merged; use -d."
        [ "$arg" = "--delete" ] && has_delete=1
        { [ "$arg" = "--force" ] || short_flag_has "$arg" f; } && has_force=1
      done
      if [ "$has_delete" -eq 1 ] && [ "$has_force" -eq 1 ]; then
        block "git branch --delete --force" \
          "this deletes a branch even if it isn't merged; use only --delete."
      fi ;;
    checkout|restore)
      for arg in "$@"; do
        is_whole_workdir "$arg" && block "git $sub $arg" \
          "this discards all uncommitted changes in the working tree."
      done
      if [ "$sub" = "checkout" ]; then
        local args=("$@") new_branch="" idx
        for ((idx = 0; idx < ${#args[@]}; idx++)); do
          case "${args[$idx]}" in
            -b|-B) new_branch="${args[$((idx + 1))]:-}" ;;
          esac
        done
        [ -n "$new_branch" ] && check_branch_creation "$new_branch" "checkout"
      fi ;;
    switch)
      local args=("$@") new_branch="" idx
      for ((idx = 0; idx < ${#args[@]}; idx++)); do
        case "${args[$idx]}" in
          -c|-C|--create|--force-create) new_branch="${args[$((idx + 1))]:-}" ;;
          --create=*) new_branch="${args[$idx]#--create=}" ;;
          --force-create=*) new_branch="${args[$idx]#--force-create=}" ;;
        esac
      done
      [ -n "$new_branch" ] && check_branch_creation "$new_branch" "switch" ;;
    push)
      local refspecs=() remote_seen=0
      for arg in "$@"; do
        case "$arg" in
          --all|--mirror)
            block "git push $arg" \
              "this pushes all branches, including main — regardless of where you are now." ;;
          -*) continue ;;
        esac
        if [ "$remote_seen" -eq 0 ]; then
          remote_seen=1
        else
          refspecs+=("$arg")
        fi
      done

      if [ "${#refspecs[@]}" -eq 0 ]; then
        # No refspec: where this goes depends on the current branch.
        is_main "$(current_branch)" && block "git push from main" \
          "main is checked out, so this push goes to main. Work on a feature branch."
        return 0
      fi

      for arg in "${refspecs[@]}"; do
        local target; target="$(refspec_target "$arg")"
        if [ "$target" = "HEAD" ]; then
          is_main "$(current_branch)" && block "git push origin HEAD from main" \
            "HEAD points to main here, so this push goes to main."
        elif is_main "$target"; then
          block "git push to main" "${REASON_PUSH_TO_MAIN:-main gets its changes via a PR, not via a direct push.}"
        fi
      done ;;
  esac
}

# Reading the token stream. Records are NUL-separated and carry a type
# character: `c` the working directory, `t` a token, `e` the end of a
# segment. Defaults to the current working directory; the stream overwrites
# it as the first record. That order is guaranteed, but the fallback belongs
# before it: a segment is already judged during the loop.
workdir="$PWD"
tokens=()
path_options=()

while IFS= read -r -d '' record; do
  # Substring expansion, not pattern matching: a value may contain glob
  # characters, and those would make a `%%` construct misfire.
  kind="${record:0:1}"
  value="${record:1}"
  case "$kind" in
    c) [ -n "$value" ] && workdir="$value" ;;
    t) tokens+=("$value") ;;
    e)
      if [ "${#tokens[@]}" -gt 0 ]; then
        judge_segment "${tokens[@]}"
      fi
      tokens=() ;;
  esac
done < "$stream"

exit 0
