{
  "schema": 1,
  "repository": "TiesL/spec-driven-guardrails",
  "enabled": false,
  "acceptance": null,
  "control_issue": 607,
  "executor_host": "",
  "max_lines": 300,
  "max_files": 8,
  "hold_seconds": 300,
  "groups": {
    "ordinary": [
      "README.md",
      "CONTEXT.md",
      "PRD*.md",
      "ARCHITECTURE.md",
      "TEST-SCENARIOS.md",
      "docs/**.md",
      "wip/**.md",
      "test/**"
    ],
    "adoption": [
      "adopt.sh",
      "install.sh",
      "pending-changes.sh",
      "CHANGES.md",
      ".gitignore",
      "lib/*adopt*",
      "lib/skill-links.sh",
      "skills/adopt-workflow/**",
      "skills/adoption-registry/**"
    ],
    "guard": [
      "hooks/**",
      ".github/**",
      ".codex/**",
      ".agents/**",
      "adapters/**",
      "settings/**",
      "policy/**",
      "AGENTS.md",
      "CLAUDE.md",
      "WORKFLOW.md",
      "USER-CLAUDE.md",
      "check",
      "check-*",
      "session-context.sh",
      "skills/deploy-guards/**",
      "lib/review-rounds*",
      "review-rounds.sh",
      "compliance-evidence.sh",
      "classify-review-depth.sh",
      "role-label-staleness.sh",
      "generate-workflow-adapters.sh",
      "wait-for-ci.sh",
      "templates/check-*",
      "templates/*guard*",
      "templates/ci.yml",
      "templates/wait-for-ci.sh"
    ],
    "generated": {
      "outputs": [
        "WORKFLOW.md",
        "adapters/codex/AGENTS.md",
        "AGENTS.md"
      ],
      "inputs": [
        "policy/WORKFLOW.md",
        "adapters/*/INSTRUCTIONS.md"
      ]
    }
  },
  "reserved": {
    "release": [
      "CHANGELOG.md",
      "VERSION",
      "package.json",
      "skills/release-branch-workflow/**"
    ],
    "autonomy": [
      "merge-preflight.sh",
      "hooks/git-guardrails",
      "skills/pre-merge-review/**",
      "lib/model-record**",
      "pipeline-override.sh",
      "skills/role-contracts/**",
      "skills/merge-risk-panel/**",
      "policy/merge-autonomy.json",
      "merge-risk-evidence.sh",
      "lib/merge-risk**",
      "test/cases/**merge_risk**",
      "test/fixtures/merge-risk**",
      "test/behavior/merge-risk**",
      "hooks/read-command.py",
      "hooks/rules.sh",
      "lib/markdown.sh",
      "lib/changes.sh",
      "lib/context-budget.sh",
      "lib/git-env.sh",
      "settings/session-hooks.json",
      "check",
      ".github/workflows/**",
      "test/lib.sh",
      "test/run.sh",
      "test/fixtures/pipeline-371-helpers.sh",
      "WORKFLOW-ADOPTION.md",
      "WORKFLOW-ADOPTIE.md",
      "check-no-dutch.sh",
      "check-no-quote-break.sh",
      "check-no-sigpipe-race.sh",
      "check-scenario-file-sync.sh",
      "check-traceability.sh",
      "check-workflow-adapters.sh",
      "lib/workflow-adapters.py",
      "lib/managed_blocks.py",
      "lib/nfr.sh",
      "lib/one-definition-lint.py",
      "templates/check-pr-issue-link.sh",
      "templates/check-main-via-pr.sh"
    ]
  },
  "labels": {
    "hold": [
      "hold",
      "risk:*"
    ],
    "off": "merge-autonomy:off"
  },
  "release_heads": [
    "release/*"
  ]
}
