#!/usr/bin/env bash
# generate-prd-block — Rewrites the NFR block in templates/PRD.md from nfr/.
#
# For that block, the template is a build artifact: checked in and diffable,
# but generated. `check` fails if the checked-in block diverges from what
# this generator produces, so the two can't silently drift apart.
#
# Usage: ./generate-prd-block

set -uo pipefail

own_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/nfr.sh
. "$own_dir/lib/nfr.sh"

template="$own_dir/templates/PRD.md"
begin='<!-- nfr-block:begin — generated by ./generate-prd-block, don'"'"'t edit by hand -->'
end='<!-- nfr-block:end -->'

if ! grep -qF "$begin" "$template" || ! grep -qF "$end" "$template"; then
  echo "generate-prd-block: markers missing in $template" >&2
  exit 1
fi

# The replacement assumes the begin marker comes before the end marker.
# The other way around, it would throw away everything in between —
# including sections that have nothing to do with the NFR block — and then
# report that as success.
line_begin="$(grep -nF "$begin" "$template" | head -1 | cut -d: -f1)"
line_end="$(grep -nF "$end" "$template" | head -1 | cut -d: -f1)"
if [ "$line_begin" -ge "$line_end" ]; then
  echo "generate-prd-block: begin marker is not before the end marker (line $line_begin versus $line_end)" >&2
  exit 1
fi

new="$(mktemp)"
block="$(mktemp)"
trap 'rm -f "$new" "$block"' EXIT

# Via a file, not via -v: awk doesn't accept a multi-line variable.
nfr_block "$own_dir/nfr" > "$block"

awk -v begin="$begin" -v end="$end" -v blockfile="$block" '
  index($0, begin) == 1 {
    print
    while ((getline line < blockfile) > 0) print line
    close(blockfile)
    skip = 1
    next
  }
  index($0, end) == 1 { skip = 0 }
  !skip { print }
' "$template" > "$new"

cp "$new" "$template"
echo "NFR block updated in templates/PRD.md"
