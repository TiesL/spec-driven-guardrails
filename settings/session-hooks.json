{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"${CLAUDE_PROJECT_DIR:-.}\"; wf=$(dirname \"$(dirname \"$(readlink \"$p/.claude/settings.json\" 2>/dev/null)\")\"); if [ -x \"$wf/hooks/git-guardrails\" ]; then exec \"$wf/hooks/git-guardrails\"; fi; exit 0",
            "statusMessage": "git-guardrails"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git fetch origin 2>&1 || true",
            "statusMessage": "git fetch origin"
          },
          {
            "type": "command",
            "command": "wf=$(dirname \"$(dirname \"$(readlink .claude/settings.json 2>/dev/null)\")\") && [ -x \"$wf/pending-changes.sh\" ] && \"$wf/pending-changes.sh\" . 2>/dev/null || true",
            "statusMessage": "openstaande workflow-wijzigingen"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$(git rev-parse --abbrev-ref HEAD)\" != \"main\" ] && git push origin HEAD 2>&1 || true",
            "statusMessage": "git push origin HEAD"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": ""
  }
}
